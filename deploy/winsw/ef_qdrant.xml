<service>
  <id>ef_qdrant</id>
  <name>ef_qdrant</name>
  <description>EF support: Qdrant vector DB (:6390)</description>
  <executable>P:\.data\yt-is\ef\tools\qdrant.exe</executable>
  <arguments>--config-path P:/.data/yt-is/ef/server/config.yaml</arguments>
  <workingdirectory>P:\.data\yt-is\ef\server</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="5 sec"/>
  <log mode="roll-by-size" sizeBytes="10485760" keepFiles="8"><logpath>P:\.data\logs\nssm</logpath></log>
</service>
