def cmd_sync(argv):
    """Run every available content connector + index the results."""
    from csf.connectors import sync_all, list_connectors
    names = None
    if argv and argv[0] == "--only":
        names = argv[1].split(",")
    print("Connectors:")
    for c in list_connectors():
        mark = "✓" if c["available"] else "—"
        print(f"  {mark} {c['name']:14s} {c['description'][:60]}")
    print()
    results = sync_all(names)
    for name, out in results.items():
        if "skipped" in out:
            print(f"  {name}: skipped ({out['skipped']})")
        elif "error" in out:
            print(f"  {name}: ERROR {out['error'][:80]}")
        else:
            print(f"  {name}: {out.get('new', '?')} new")
    return 0


