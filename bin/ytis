def cmd_web():
    """Open the web search interface in the browser."""
    import webbrowser
    import urllib.request
    service_up = False
    try:
        with urllib.request.urlopen("http://127.0.0.1:6391/health", timeout=3) as r:
            service_up = r.status == 200
    except Exception:
        pass

    if service_up:
        # Same-origin page served by the query service — file:// pages get
        # blocked by Chromium's Local Network Access rules.
        webbrowser.open("http://127.0.0.1:6391/")
        print("Web search opened in browser")
        print("  Location: http://127.0.0.1:6391/")
    else:
        search_page = REPO / "docs" / "search.html"
        webbrowser.open(f"file:///{search_page}")
        print("Search page opened from disk (query service is DOWN)")
        print("  Start it for live results:  python -m ef.warm_query_service")
        print("  Then use:  ytis web")


def cmd_today():
    """What your channels taught you recently."""
    cutoff = (datetime.now(timezone.utc) - timedelta(hours=24)).isoformat()

    conn = _ro(DB)
    rows = conn.execute("""
        SELECT video_id, title, updated_at FROM analysis_status
        WHERE status = 'complete' AND updated_at >= ?
        ORDER BY updated_at DESC LIMIT 20
    """, (cutoff,)).fetchall()
    conn.close()

    if not rows:
        print("No new transcripts in the last 24 hours.")
        print("Run 'ytis run' to scan for new content.")
        return

    print(f"Today's knowledge — {_plural(len(rows), 'new transcript')} in the last 24h")
    print("═════════════════════════════════════════════════")
    print()
    for vid, title, ts in rows[:15]:
        print(f"  • {title or vid}")
        print(f"    {_time_ago(ts)} — https://youtube.com/watch?v={vid}")
    if len(rows) > 15:
        print(f"  ... and {len(rows) - 15} more")
    print()

    # Check for new artifacts
    new_artifacts = []
    if VISUAL_ROOT.is_dir():
        for d in VISUAL_ROOT.iterdir():
            art = d / "artifacts.md"
            if art.exists():
                try:
                    mtime = datetime.fromtimestamp(art.stat().st_mtime, tz=timezone.utc)
                    if mtime.isoformat() >= cutoff:
                        title_row = _ro(DB).execute(
                            "SELECT title FROM analysis_status WHERE video_id = ?", (d.name,)
                        ).fetchone()
                        new_artifacts.append((d.name, title_row[0] if title_row else d.name))
                except OSError:
                    pass

    if new_artifacts:
        print(f"New code artifacts extracted ({len(new_artifacts)}):")
        for vid, title in new_artifacts[:5]:
            print(f"  • {title}")
            print(f"    P:/.data/yt-is/visual/{vid}/artifacts.md")
        print()

    # Check for new insights
    insights_dir = Path("P:/.data/yt-is/insights")
    if insights_dir.is_dir():
        recent_insights = [f for f in insights_dir.glob("*.md") if f.stat().st_mtime > time.time() - 86400]
        if recent_insights:
            print("Recent insight reports:")
            for f in recent_insights:
                print(f"  • {f.name}")
            print()


def cmd_topics():
    """List discovered topic areas."""
    try:
        conn = _ro(EF_CATALOG)
        rows = conn.execute("""
            SELECT label, member_count, video_count, top_terms
            FROM topic_clusters WHERE member_count > 0
            ORDER BY member_count DESC LIMIT 30
        """).fetchall()
        conn.close()
    except sqlite3.OperationalError:
        print("No topics discovered yet. Run: python -m ef.clustering")
        return

    if not rows:
        print("No topics discovered yet. Run: python -m ef.clustering")
        return

    print(f"Discovered topics ({len(rows)} shown, largest first)")
    print("════════════════════════════════════════════")
    print()
    for i, (label, chunks, videos, terms) in enumerate(rows, 1):
        terms_str = ", ".join(json.loads(terms)[:5]) if terms else ""
        print(f"{i:3}. {label}")
        print(f"     {_fmt_n(videos)} videos | {terms_str}")
    print()


def cmd_channels():
    """List tracked channels and their status."""
    conn = _ro(DB)
    rows = conn.execute("""
        SELECT cm.channel_title, cm.channel_id,
               (SELECT COUNT(*) FROM analysis_status WHERE channel_id = cm.channel_id AND status = 'complete') as vids,
               (SELECT COUNT(*) FROM analysis_status WHERE channel_id = cm.channel_id AND status = 'pending') as pending
        FROM channel_metadata cm
        ORDER BY vids DESC LIMIT 30
    """).fetchall()
    conn.close()

    if not rows:
        print("No channels tracked. Add one with: ytis add <channel_url>")
        return

    print(f"Tracked channels ({len(rows)} shown, most videos first)")
    print("═════════════════════════════════════════════")
    print()
    for title, cid, vids, pending in rows:
        status = f"{_fmt_n(vids)} done"
        if pending:
            status += f", {_fmt_n(pending)} pending"
        print(f"  {title or cid}: {status}")
    print()


def cmd_import(filepath):
    """Import channels from a file (one URL/ID per line, or OPML)."""
    path = Path(filepath)
    if not path.exists():
        print(f"File not found: {filepath}")
        return

    content = path.read_text(encoding="utf-8")

    # Detect OPML (YouTube Takeout export)
    if "<opml" in content.lower() or "<outline" in content.lower():
        import re
        urls = re.findall(r'xmlUrl="([^"]+)"', content)
        if not urls:
            # Try htmlUrl for YouTube channels
            urls = re.findall(r'htmlUrl="([^"]+)"', content)
        # Extract channel IDs from RSS URLs
        ids = []
        for url in urls:
            match = re.search(r'channel_id=([A-Za-z0-9_-]+)', url)
            if match:
                ids.append(match.group(1))
            elif 'youtube.com' in url:
                ids.append(url)
        entries = ids
        print(f"Found {len(entries)} channels in OPML file")
    else:
        # Plain text: one URL or ID per line
        entries = [line.strip() for line in content.splitlines() if line.strip()]
        print(f"Found {len(entries)} channels in text file")

    if not entries:
        print("No channels found to import")
        return

    print(f"Adding {len(entries)} channels...")
    added = 0
    for entry in entries:
        result = subprocess.run(
            [sys.executable, str(REPO / "bin" / "csf-source"), "add", entry],
            cwd=str(REPO),
            capture_output=True,
            text=True,
            timeout=30,
        )
        if result.returncode == 0:
            added += 1
        else:
            # Check if already tracked (not an error)
            if "already" in (result.stdout + result.stderr).lower():
                added += 1
            else:
                print(f"  Failed: {entry} — {(result.stderr or result.stdout)[:80]}")

    print(f"\nDone: {added}/{len(entries)} channels tracked")
    print("Run 'ytis run' to scan them for videos")



# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="ytis",
        description="YouTube Intelligence System — one command for everything",
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("status", help="Is it working? What's the state?")
    sub.add_parser("run", help="Apply review decisions + scan channels + fetch")
    sub.add_parser("review", help="Open channel review page in browser")
    sub.add_parser("reddit", help="Sync Reddit posts from AI subreddits")
    sub.add_parser("hn", help="Sync Hacker News stories")
    sub.add_parser("rss", help="Sync RSS/blog feeds")
    sub.add_parser("github", help="Sync GitHub repos")
    sub.add_parser("sync", help="Run ALL content connectors + index")
    sub.add_parser("purge", help="Purge channels (dry-run by default)")
    sub.add_parser("discord", help="Sync Discord channel messages")
    sub.add_parser("digest", help="Generate daily digest")
    sub.add_parser("today", help="What's new in the last 24 hours")
    sub.add_parser("topics", help="List discovered topic areas")
    sub.add_parser("channels", help="List tracked channels")
    sub.add_parser("web", help="Open web search interface in browser")

    search_p = sub.add_parser("search", help="Semantic search across transcripts")
    search_p.add_argument("query", help="What to search for")
    search_p.add_argument("--top-k", type=int, default=10)

    add_p = sub.add_parser("add", help="Add a new channel to track")
    add_p.add_argument("url", help="Channel or playlist URL")

    import_p = sub.add_parser("import", help="Import channels from a file")
    import_p.add_argument("file", help="Text file (one URL per line) or OPML export")

    args = parser.parse_args(argv)

    if args.command == "status":
        cmd_status()
    elif args.command == "run":
        cmd_run()
    elif args.command == "review":
        cmd_review()
    elif args.command == "reddit":
        cmd_reddit()
    elif args.command == "hn":
        cmd_hn()
    elif args.command == "rss":
        cmd_rss()
    elif args.command == "github":
        cmd_github()
    elif args.command == "sync":
        cmd_sync(sys.argv[2:])
    elif args.command == "purge":
        cmd_purge()
    elif args.command == "discord":
        cmd_discord()
    elif args.command == "digest":
        cmd_digest()
    elif args.command == "web":
        cmd_web()
    elif args.command == "search":
        cmd_search(args.query, args.top_k)
    elif args.command == "today":
        cmd_today()
    elif args.command == "topics":
        cmd_topics()
    elif args.command == "channels":
        cmd_channels()
    elif args.command == "add":
        cmd_add(args.url)
    elif args.command == "import":
        cmd_import(args.file)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
