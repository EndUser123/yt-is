#!/usr/bin/env python3
"""ytis — one command for the YouTube Intelligence System.

Usage:
    ytis status          Is it working? What's the state?
    ytis run             Scan channels + fetch new videos + extract knowledge
    ytis search <query>  Semantic search across all transcripts and artifacts
    ytis today           What your channels taught you recently
    ytis topics          List discovered topic areas
    ytis channels        List tracked channels and their status
    ytis add <url>       Add a new YouTube channel or playlist to track
"""

from __future__ import annotations

import argparse
import json
import os
import sqlite3
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO))

DB = Path("P:/.data/yt-is/batch_status.sqlite")
TDB = Path("P:/.data/yt-is/transcripts.sqlite")
EF_CATALOG = Path("P:/.data/yt-is/ef/catalog.sqlite")
VISUAL_ROOT = Path("P:/.data/yt-is/visual")

# ─────────────────────────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────────────────────────

def _ro(path):
    conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=5.0)
    conn.execute("PRAGMA busy_timeout=3000")
    return conn


def _fmt_n(n):
    return f"{n:,}" if isinstance(n, int) else str(n)


def _plural(n, word):
    return f"{n} {word}{'s' if n != 1 else ''}"


def _time_ago(iso_str):
    if not iso_str:
        return "unknown"
    try:
        dt = datetime.fromisoformat(iso_str.replace("Z", "+00:00"))
        delta = datetime.now(timezone.utc) - dt
        if delta.days > 0:
            return f"{delta.days}d ago"
        hours = delta.seconds // 3600
        if hours > 0:
            return f"{hours}h ago"
        minutes = delta.seconds // 60
        return f"{max(minutes, 1)}m ago"
    except (ValueError, TypeError):
        return "unknown"


def _is_process_running(script_name):
    try:
        import psutil
        me = os.getpid()
        for p in psutil.process_iter(['pid', 'cmdline']):
            if p.info['pid'] == me:
                continue
            cl = p.info['cmdline'] or []
            if len(cl) >= 2 and script_name in str(cl[1]):
                return True
    except ImportError:
        pass
    return False


def _drain_state():
    try:
        state = json.loads(Path("P:/.data/yt-is/unattended-backlog/state.json").read_text(encoding="utf-8"))
        return state.get("status", "unknown")
    except (OSError, json.JSONDecodeError):
        return "no state file"


# ─────────────────────────────────────────────────────────────────────────────
# Commands
# ─────────────────────────────────────────────────────────────────────────────

def cmd_status():
    """Is it working? What's the state?"""
    conn = _ro(DB)

    pending = conn.execute("SELECT COUNT(*) FROM analysis_status WHERE status='pending'").fetchone()[0]
    complete = conn.execute("SELECT COUNT(*) FROM analysis_status WHERE status='complete'").fetchone()[0]
    failed = conn.execute("SELECT COUNT(*) FROM analysis_status WHERE status='failed'").fetchone()[0]
    channels = conn.execute("SELECT COUNT(*) FROM channel_metadata").fetchone()[0]
    conn.close()

    tdb = _ro(TDB)
    transcripts = tdb.execute("SELECT COUNT(*) FROM transcript_cache").fetchone()[0]
    tdb.close()

    artifacts = len(list(VISUAL_ROOT.glob("*/artifacts.md"))) if VISUAL_ROOT.is_dir() else 0
    wiki_pages = len(list(VISUAL_ROOT.glob("wiki-staging/*.md"))) if (VISUAL_ROOT / "wiki-staging").is_dir() else 0

    try:
        ef_conn = _ro(EF_CATALOG)
        topics = ef_conn.execute("SELECT COUNT(*) FROM topic_clusters WHERE member_count > 0").fetchone()[0]
        ef_conn.close()
    except sqlite3.OperationalError:
        topics = 0

    drain = _drain_state()
    loop_alive = _is_process_running("run_continuous_ops.py")
    worker_alive = _is_process_running("run_visual_worker.py")

    print("ytis status")
    print("═════════")
    print()

    # Health
    if loop_alive:
        print("  ● Running (continuous ops loop active)")
    else:
        print("  ○ Stopped (loop not running — start with: python scripts/run_continuous_ops.py --loop)")
    print(f"    Drain: {drain} | Worker: {'active' if worker_alive else 'idle'}")
    print()

    # Numbers
    print(f"  Transcripts: {_fmt_n(complete)} complete, {_fmt_n(pending)} pending, {_fmt_n(failed)} failed")
    print(f"  Channels: {_fmt_n(channels)} tracked")
    print(f"  Topics: {_fmt_n(topics)} discovered")
    print(f"  Code artifacts: {_fmt_n(artifacts)} extracted")
    print(f"  Wiki pages: {_fmt_n(wiki_pages)} staged")

    # Recent activity
    conn = _ro(DB)
    recent = conn.execute("""
        SELECT COUNT(*), MAX(updated_at) FROM analysis_status
        WHERE status = 'complete' AND updated_at >= ?
    """, ((datetime.now(timezone.utc) - timedelta(hours=24)).isoformat(),)).fetchone()
    conn.close()

    if recent[0] > 0:
        print(f"  Last 24h: {_fmt_n(recent[0])} new transcripts ( {_time_ago(recent[1])} )")
    else:
        print(f"  Last 24h: no new transcripts")

    print()


def cmd_review():
    """Build and open the channel review page in your browser."""
    # Build the page
    result = subprocess.run(
        [sys.executable, str(REPO / "scripts" / "build_channel_review_page.py")],
        cwd=str(REPO),
        capture_output=True,
        text=True,
        timeout=60,
    )
    if result.returncode != 0:
        print(f"Failed to build review page: {result.stderr[:200]}")
        return

    # Find the generated file
    review_page = REPO / ".logs" / "channel_review" / "review.html"
    if not review_page.exists():
        print(f"Review page not found at {review_page}")
        return

    # Open in browser
    import webbrowser
    webbrowser.open(f"file:///{review_page}")
    print(f"Review page opened in browser")
    print(f"  Location: {review_page}")
    print()
    print("Instructions:")
    print("  1. Click category cells to classify channels")
    print("  2. Click ✕ to block a channel")
    print("  3. Click 'Export Decisions' to save review_decisions.json")
    print("  4. Run 'ytis run' to apply decisions and sync")


def cmd_run():
    """Apply channel review decisions (if any), then scan + fetch."""
    # Check for exported review decisions in Downloads
    downloads = Path.home() / "Downloads"
    decisions_file = downloads / "review_decisions.json"

    if decisions_file.exists():
        print(f"Found channel review decisions: {decisions_file}")
        print("Applying...")
        result = subprocess.run(
            [sys.executable, str(REPO / "scripts" / "apply_channel_review.py"),
             str(decisions_file)],
            cwd=str(REPO),
            capture_output=True,
            text=True,
            timeout=120,
        )
        if result.returncode == 0:
            print("  Applied successfully")
            # Move to processed to avoid re-applying
            processed = downloads / "review_decisions.applied.json"
            decisions_file.rename(processed)
            print(f"  Moved to: {processed.name}")
        else:
            print(f"  Failed to apply: {result.stderr[:200]}")
            print("  Continuing with sync anyway...")
        print()

    print("Starting full pipeline (scan channels → fetch transcripts)...")
    print("This takes 30-60 min for the scan, then runs until new videos are done.")
    print("Ctrl-C is safe — progress is saved.")
    print()
    try:
        result = subprocess.run(
            [sys.executable, str(REPO / "scripts" / "run_intake_pipeline.py")],
            cwd=str(REPO),
        )
        sys.exit(result.returncode)
    except KeyboardInterrupt:
        print("\n\nInterrupted — progress is saved.")
        print("Already-scanned channels and fetched videos are safe.")
        print("Re-run 'ytis run' to continue (already-checked channels will be fast).")
        sys.exit(130)


def cmd_search(query, top_k=10):
    """Semantic search across all transcripts and artifacts."""
    # Try the warm query service first (fast)
    try:
        import urllib.request
        import urllib.parse
        params = urllib.parse.urlencode({"q": query, "top_k": top_k, "format": "text"})
        with urllib.request.urlopen(f"http://127.0.0.1:6391/query?{params}", timeout=30) as r:
            if r.status == 200:
                print(r.read().decode("utf-8"))
                return
    except Exception:
        pass  # warm service not running — fall through to CLI

    # Fall back to ef-query CLI
    result = subprocess.run(
        [sys.executable, str(REPO / "bin" / "ef-query"), query,
         "--top-k", str(top_k), "--format", "text"],
        cwd=str(REPO),
        capture_output=True,
        text=True,
        timeout=120,
    )
    if result.returncode == 0 and result.stdout.strip():
        print(result.stdout)
    else:
        print(f"No results for '{query}' (or search infrastructure not running)")
        print(f"Try: python -m ef.warm_query_service  (to start the search service)")


