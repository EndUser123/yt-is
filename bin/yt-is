#!/usr/bin/env python3
"""YouTube channel management — check for new videos and manage tracked channels.

Usage:
    yt-is sync              # Check all tracked channels for new videos
    yt-is list              # List all tracked channels
    yt-is add <url>         # Add a new channel to track
    yt-is history           # Import channels from watch history
    yt-is watchlater        # Import channels from Watch Later
    yt-is fetch             # Download pending transcripts (full fallback chain)
    yt-is fetch --dry-run   # Preview what would be fetched
"""

import argparse
import os
import subprocess
import sys
from pathlib import Path

CSF_SOURCE = Path(__file__).parent / "csf-source"
sys.path.insert(0, str(Path(__file__).parent.parent))

from csf.csf_logging import log_action
from csf.deps_check import run_check as _run_deps_check
from csf.nlm_auth_check import ensure_storage as _ensure_nlm_storage, skip_env_set as _nlm_skip_env_set


def _resolve_deps_flags(argv: list[str]) -> tuple[bool, bool, bool]:
    """Pre-scan argv for deps flags before argparse claims subcommand args.

    Returns (skip, strict, check_only). Env vars act as defaults.
    Also skips the check when --help/-h is present so help output stays clean.
    """
    help_requested = any(a in ("--help", "-h") for a in argv)
    skip = (
        "--skip-deps-check" in argv
        or help_requested
        or os.environ.get("YTIS_SKIP_DEPS_CHECK", "").lower() in ("1", "true", "yes", "on")
    )
    strict = "--strict-deps" in argv or os.environ.get(
        "YTIS_STRICT_DEPS", ""
    ).lower() in ("1", "true", "yes", "on")
    check_only = "--check-deps" in argv
    return skip, strict, check_only


def main() -> None:
    # Startup dependency check — non-blocking by default.
    # Pre-scan argv because top-level flags must precede the subcommand,
    # and skip when --help/-h is present so help output stays clean.
    _skip_deps, _strict_deps, _check_deps_only = _resolve_deps_flags(sys.argv[1:])

    if _check_deps_only:
        # User asked only for the deps report; exit after.
        sys.exit(_run_deps_check(strict=True, skip=False))

    if not _skip_deps:
        _run_deps_check(strict=_strict_deps)

    # NLM auth storage preflight. Skip only for non-NLM commands or explicit env override.
    # Always runs before subcommand dispatch so every fetch/sync gets the check.
    if not _nlm_skip_env_set() and not any(a in ("--help", "-h") for a in sys.argv[1:]):
        if not _ensure_nlm_storage():
            print(
                "[yt-is] NLM auth storage unavailable. Halting to avoid silent auth failures.",
                file=sys.stderr,
            )
            sys.exit(2)

    parser = argparse.ArgumentParser(
        description="YouTube channel management — check for new videos and manage tracked channels."
    )
    parser.add_argument(
        "--check-deps",
        action="store_true",
        help="Check library versions against requirements.txt and exit",
    )
    parser.add_argument(
        "--skip-deps-check",
        action="store_true",
        help="Skip the startup dependency version check",
    )
    parser.add_argument(
        "--strict-deps",
        action="store_true",
        help="Exit nonzero if any library is outdated or missing",
    )
    subparsers = parser.add_subparsers(dest="command", help="Command to run")

    # sync command: check all channels for new videos
    sync_parser = subparsers.add_parser("sync", help="Check all tracked channels for new videos")
    sync_parser.add_argument(
        "--verbose", "-v", action="store_true", help="Show detailed output"
    )

    # list command: list all tracked channels
    list_parser = subparsers.add_parser("list", help="List all tracked channels")

    # add command: add a new channel
    add_parser = subparsers.add_parser("add", help="Add a new channel to track")
    add_parser.add_argument("url", help="Channel URL or playlist URL")

    # history command: import tracked channels from watch history
    history_parser = subparsers.add_parser(
        "history",
        help="Extract channels from YouTube watch history and add new ones",
    )
    history_parser.add_argument("--dry-run", action="store_true", help="Preview channels without adding them")
    history_parser.add_argument(
        "--min-history-videos",
        type=int,
        default=2,
        help="Minimum videos watched from a channel to qualify (default: 2)",
    )
    history_parser.add_argument(
        "--cookies-from-browser",
        default=None,
        help="Read YouTube cookies from a live browser profile, e.g. firefox:default-release",
    )

    # watchlater command: import tracked channels from Watch Later
    watchlater_parser = subparsers.add_parser(
        "watchlater",
        help="Extract channels from YouTube Watch Later and add new ones",
    )
    watchlater_parser.add_argument("--dry-run", action="store_true", help="Preview channels without adding them")
    watchlater_parser.add_argument(
        "--min-watchlater-videos",
        type=int,
        default=2,
        help="Minimum videos in Watch Later from a channel to qualify (default: 2)",
    )
    watchlater_parser.add_argument(
        "--cookies-from-browser",
        default=None,
        help="Read YouTube cookies from a live browser profile, e.g. firefox:default-release",
    )

    # fetch command: download pending transcripts via the full fallback chain
    fetch_parser = subparsers.add_parser(
        "fetch",
        help="Download pending transcripts via the full fallback chain (oEmbed → yt-dlp → yt-dlp+cookies → direct API → NotebookLM → Selenium → Whisper)",
    )
    fetch_parser.add_argument("--dry-run", action="store_true", help="Preview what would be fetched")
    fetch_parser.add_argument("--source", type=str, help="Process only one channel (by URL)")
    fetch_parser.add_argument("--workers", type=int, default=1, help="Number of parallel workers (default: 1)")

    args = parser.parse_args()

    # Default to sync if no command provided
    if args.command is None:
        args.command = "sync"
        args.verbose = False

    if args.command == "sync":
        # Check all channels for new videos
        result = subprocess.run(
            [sys.executable, str(CSF_SOURCE), "check-all"] + (["--verbose"] if args.verbose else [])
        )
        sys.exit(result.returncode)

    elif args.command == "list":
        # List all tracked channels
        result = subprocess.run([sys.executable, str(CSF_SOURCE), "list"])
        sys.exit(result.returncode)

    elif args.command == "add":
        # Add a new channel
        result = subprocess.run([sys.executable, str(CSF_SOURCE), "add", args.url])
        sys.exit(result.returncode)

    elif args.command == "history":
        fetch_cmd = [sys.executable, str(CSF_SOURCE), "history"]
        if args.dry_run:
            fetch_cmd.append("--dry-run")
        if args.min_history_videos != 2:
            fetch_cmd.extend(["--min-history-videos", str(args.min_history_videos)])
        if args.cookies_from_browser:
            fetch_cmd.extend(["--cookies-from-browser", args.cookies_from_browser])
        log_action(
            "yt_is_dispatch_started",
            {
                "command": "history",
                "cwd": str(Path.cwd()),
                "backend": str(CSF_SOURCE),
                "argv": fetch_cmd,
            },
        )
        result = subprocess.run(fetch_cmd)
        log_action(
            "yt_is_dispatch_finished",
            {
                "command": "history",
                "backend": str(CSF_SOURCE),
                "returncode": result.returncode,
            },
        )
        sys.exit(result.returncode)

    elif args.command == "watchlater":
        fetch_cmd = [sys.executable, str(CSF_SOURCE), "watchlater"]
        if args.dry_run:
            fetch_cmd.append("--dry-run")
        if args.min_watchlater_videos != 2:
            fetch_cmd.extend(["--min-watchlater-videos", str(args.min_watchlater_videos)])
        if args.cookies_from_browser:
            fetch_cmd.extend(["--cookies-from-browser", args.cookies_from_browser])
        log_action(
            "yt_is_dispatch_started",
            {
                "command": "watchlater",
                "cwd": str(Path.cwd()),
                "backend": str(CSF_SOURCE),
                "argv": fetch_cmd,
            },
        )
        result = subprocess.run(fetch_cmd)
        log_action(
            "yt_is_dispatch_finished",
            {
                "command": "watchlater",
                "backend": str(CSF_SOURCE),
                "returncode": result.returncode,
            },
        )
        sys.exit(result.returncode)

    elif args.command == "fetch":
        # Download pending transcripts via the full fallback chain
        fetch_cmd = [sys.executable, str(CSF_SOURCE), "fetch"]
        if args.dry_run:
            fetch_cmd.append("--dry-run")
        if args.source:
            fetch_cmd.extend(["--source", args.source])
        if args.workers != 1:
            fetch_cmd.extend(["--workers", str(args.workers)])
        log_action(
            "yt_is_dispatch_started",
            {
                "command": "fetch",
                "cwd": str(Path.cwd()),
                "backend": str(CSF_SOURCE),
                "argv": fetch_cmd,
            },
        )
        result = subprocess.run(fetch_cmd)
        log_action(
            "yt_is_dispatch_finished",
            {
                "command": "fetch",
                "backend": str(CSF_SOURCE),
                "returncode": result.returncode,
            },
        )
        sys.exit(result.returncode)

    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
