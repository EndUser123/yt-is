    def _build_worker_source_profile_totals_payload() -> dict[str, object]:
        return {
            "total": industrial_source_profile_totals["total"],
            "matched": industrial_source_profile_totals["matched"],
            "missing": industrial_source_profile_totals["missing"],
            "source_class_counts": dict(industrial_source_profile_totals["source_class_counts"]),
            "status_counts": dict(industrial_source_profile_totals["status_counts"]),
            "privacy_status_counts": dict(industrial_source_profile_totals["privacy_status_counts"]),
            "upload_status_counts": dict(industrial_source_profile_totals["upload_status_counts"]),
            "unavailable_reason_counts": dict(industrial_source_profile_totals["unavailable_reason_counts"]),
            "failure_reason_counts": dict(industrial_source_profile_totals["failure_reason_counts"]),
        }

    # Canonical auth preflight must precede any streaming queue dispatch. The
    # scan can fill and service industrial batches before it reaches the
    # post-scan summary, so placing this gate after the scan can start workers
    # under a failed account or bypass the intended fail-closed behavior.
    account_profile = os.getenv("YTIS_NLM_ACCOUNT_PROFILE", "").strip()
    if not account_profile:
        _log_fetch_terminal_failure("canonical_auth_preflight:missing_account_profile")
        print("[source] FATAL: YTIS_NLM_ACCOUNT_PROFILE is required", file=sys.stderr)
        sys.exit(1)
    probe = ensure_account_session(
        account_profile,
        worker_id="coordinator",
        allow_bootstrap=False,
    )
    if not probe.ok:
        _log_fetch_terminal_failure(f"canonical_auth_preflight:{probe.reason}")
        print(
            f"[source] FATAL: canonical NotebookLM account {account_profile!r} preflight failed: "
            f"{probe.reason}; storage={probe.storage_path} expected={probe.expected_email}",
            file=sys.stderr,
        )
        sys.exit(1)
    os.environ["YTIS_NLM_AUTH_NONINTERACTIVE"] = "1"
    log_action(
        "nlm_auth_storage_probe_ok",
        {
            "component": "source",
            "account_profile": probe.account_profile,
            "expected_email": probe.expected_email,
            "storage_path": probe.storage_path,
            "worker_id": probe.worker_id,
        },
    )

    def _run_industrial_worker(worker_id: int, worker_batches: list[list[str]]) -> tuple[int, dict[str, object], str, str]:
        launch = _build_industrial_worker_launch(
            worker_id=worker_id,
            worker_batches=worker_batches,
        )
        state_path = Path(str(launch["state_path"]))
        notebook_title = str(launch["notebook_title"])
        notebooklm_profile = str(launch["notebooklm_profile"])
        worker_label = str(launch["worker_label"])
        account_profile = str(launch["account_profile"])
        worker_env = launch["env"]
        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False, encoding="utf-8") as tmp:
            json.dump(worker_batches, tmp)
            batch_file = Path(tmp.name)
        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False, encoding="utf-8") as tmp:
            result_path = Path(tmp.name)
        started_at = time.monotonic()
        log_action(
            "fetch_worker_started",
            {
                "worker_id": worker_label,
                "batch_count": len(worker_batches),
                "video_count": sum(len(batch) for batch in worker_batches),
                "state_path": str(state_path),
                "notebook_title": notebook_title,
                "notebooklm_profile": notebooklm_profile,
                "account_profile": account_profile,
            },
        )
        cmd = [
            sys.executable,
            "-m",
            "dev.worker_pool.worker_main",
            "--input",
            str(batch_file),
            "--state-path",
            str(state_path),
            "--notebook-title",
            notebook_title,
            "--notebooklm-profile",
            notebooklm_profile,
            "--account-profile",
            account_profile,
            "--worker-id",
            worker_label,
            "--result-path",
            str(result_path),
        ]
        timeout_s = _industrial_worker_timeout_s()
        creationflags = getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0) if os.name == "nt" else 0
        try:
            proc = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                env=worker_env,
                creationflags=creationflags,
                start_new_session=os.name != "nt",
            )
            try:
                stdout_text, stderr_text = proc.communicate(timeout=timeout_s)
            except subprocess.TimeoutExpired as exc:
                _terminate_process_tree_pid(proc.pid)
                try:
                    stdout_text, stderr_text = proc.communicate(timeout=30)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    stdout_text, stderr_text = proc.communicate()
                raise TimeoutError(
                    f"industrial worker {worker_label} timed out after {timeout_s:g}s"
                ) from exc
        except TimeoutError:
            try:
                result_path.unlink()
            except Exception:
                pass
            raise
        except Exception:
            try:
                result_path.unlink()
            except Exception:
                pass
            raise
        finally:
            try:
                batch_file.unlink()
            except Exception:
                pass
        elapsed_s = round(time.monotonic() - started_at, 3)
        summary = _load_worker_summary(result_path, stdout_text)
        if stdout_text:
            stdout_text = stdout_text.rstrip()
            if stdout_text:
                print(stdout_text)
        if stderr_text:
            stderr_text = stderr_text.rstrip()
            if stderr_text:
                print(stderr_text, file=sys.stderr)
        try:
            result_path.unlink()
        except Exception:
            pass
        log_action(
            "fetch_worker_finished",
            {
                "worker_id": worker_label,
                "batch_count": len(worker_batches),
                "video_count": sum(len(batch) for batch in worker_batches),
                "returncode": proc.returncode,
                "elapsed_s": elapsed_s,
                "summary": summary,
            },
        )
        return (worker_id, summary, stdout_text, stderr_text)

    def _service_industrial_workers(
        wait_for_completion: bool = False,
        *,
        input_closed: bool = False,
    ) -> None:
        nonlocal industrial_batch_queue, industrial_worker_executor, industrial_worker_futures
        nonlocal industrial_worker_slots_in_use, industrial_worker_slot_health, industrial_batches_processed, industrial_dispatch_cycle
        nonlocal industrial_worker_assignment_ids, industrial_worker_assignment_batches, industrial_worker_assignment_payloads
        nonlocal success_count, fail_count, transcript_fallback_processed_count
        nonlocal industrial_first_worker_finished_at, industrial_last_worker_finished_at
        nonlocal industrial_completion_stall_alert_logged, industrial_oversized_dispatch_alert_logged

        if wait_for_completion and industrial_worker_futures:
            done, _ = wait(industrial_worker_futures, return_when=FIRST_COMPLETED)
        else:
            done, _ = wait(industrial_worker_futures, timeout=0, return_when=FIRST_COMPLETED)

        for future in done:
            industrial_worker_futures.remove(future)
            assignment_id = industrial_worker_assignment_ids.pop(future, "")
            batch_ids = industrial_worker_assignment_batches.pop(future, [])
            worker_payload = industrial_worker_assignment_payloads.pop(future, [])
            try:
                worker_id, summary, _stdout, _stderr = future.result()
            except Exception as exc:
                if adaptive_scheduler is None:
                    raise
                failure_kind = "worker_timeout" if isinstance(exc, TimeoutError) else "worker_exception"
                worker_id = industrial_worker_slots_in_use.pop(future, 0)
                if worker_id:
                    adaptive_scheduler.mark_failed(
                        worker_id,
                        now_s=time.monotonic() - fetch_started_at,
                        assignment_id=assignment_id,
                        failure_kind=failure_kind,
                    )
                    log_action(
                        "adaptive_worker_quarantined",
                        {
                            "run_id": industrial_run_id,
                            "lane": os.getenv("YTIS_NLM_LANE", ""),
                            "worker_id": f"worker-{worker_id:02d}",
                            "target_workers": adaptive_scheduler.target_workers,
                            "active_workers": len(industrial_worker_futures),
                            "queued_batches": len(industrial_batch_queue),
                            "reason": failure_kind,
                            "policy_version": "adaptive-worker-scheduler-v1",
                            "timestamp_monotonic_s": time.monotonic(),
                        },
                    )
                else:
                    failure_kind = "worker_slot_missing"
                _requeue_adaptive_assignment(
                    industrial_batch_queue,
                    worker_payload,
                    adaptive_assignment_ledger,
                    assignment_id,
                )
                log_action(
                    "adaptive_assignment_failed",
                    {
                        "run_id": industrial_run_id,
                        "lane": os.getenv("YTIS_NLM_LANE", ""),
                        "assignment_id": assignment_id,
                        "worker_id": f"worker-{worker_id:02d}" if worker_id else "unknown",
                        "target_workers": adaptive_scheduler.target_workers,
                        "active_workers": len(industrial_worker_futures),
                        "queued_batches": len(industrial_batch_queue),
                        "reason": failure_kind,
                        "policy_version": "adaptive-worker-scheduler-v1",
                        "timestamp_monotonic_s": time.monotonic(),
                        "batch_ids": batch_ids,
                        **_adaptive_accounting_payload(),
                        "requeued": True,
                        "failure_kind": failure_kind,
                        "error": repr(exc),
                    },
                )
                continue
            slot_id = industrial_worker_slots_in_use.pop(future, worker_id)
            batch_count = int(summary.get("batch_count", 0) or 0)
            video_count = int(summary.get("video_count", 0) or 0)
            succeeded = int(summary.get("succeeded", 0) or 0)
            failed = int(summary.get("failed", 0) or 0)
            elapsed_s = float(summary.get("elapsed_s", 0.0) or 0.0)
            industrial_batches_processed += batch_count
            success_count += succeeded
            fail_count += failed
            requeue_assignment = False
            if adaptive_scheduler is not None:
                health_ok, health_reason = _classify_adaptive_worker_health(
                    summary,
                    max_failure_rate=adaptive_scheduler.config.max_failure_rate,
                )
                sample = HealthSample(
                    worker_id=slot_id,
                    success=health_ok,
                    failure_kind=(
                        health_reason
                        if not health_ok
                        else ""
                    ),
                )
                industrial_worker_health_samples.append(sample)
                requeue_assignment = (
                    not sample.success
                    and _adaptive_result_requires_requeue(summary, sample.failure_kind)
                )
                if adaptive_assignment_ledger is not None:
                    if sample.success:
                        adaptive_assignment_ledger.complete(assignment_id)
                    else:
                        adaptive_assignment_ledger.fail(
                            assignment_id,
                            requeue=requeue_assignment,
                        )
                if requeue_assignment:
                    industrial_batch_queue[0:0] = worker_payload
                if sample.success:
                    adaptive_scheduler.mark_completed(
                        slot_id,
                        now_s=time.monotonic() - fetch_started_at,
                        assignment_id=assignment_id,
                    )
                else:
                    adaptive_scheduler.mark_failed(
                        slot_id,
                        now_s=time.monotonic() - fetch_started_at,
                        assignment_id=assignment_id,
                        failure_kind=sample.failure_kind,
                    )
                    log_action(
                        "adaptive_worker_quarantined",
                        {
                            "run_id": industrial_run_id,
                            "lane": os.getenv("YTIS_NLM_LANE", ""),
                            "worker_id": f"worker-{slot_id:02d}",
                            "target_workers": adaptive_scheduler.target_workers,
                            "active_workers": len(industrial_worker_futures),
                            "queued_batches": len(industrial_batch_queue),
                            "reason": sample.failure_kind,
                            "policy_version": "adaptive-worker-scheduler-v1",
                            "timestamp_monotonic_s": time.monotonic(),
                        },
                    )
                if sample.success:
                    log_action(
                        "adaptive_worker_stopped",
                        {
                            "run_id": industrial_run_id,
                            "lane": os.getenv("YTIS_NLM_LANE", ""),
                            "worker_id": f"worker-{slot_id:02d}",
                            "target_workers": adaptive_scheduler.target_workers,
                            "active_workers": len(industrial_worker_futures),
                            "queued_batches": len(industrial_batch_queue),
                            "reason": "assignment_completed",
                            "policy_version": "adaptive-worker-scheduler-v1",
                            "timestamp_monotonic_s": time.monotonic(),
                        },
                    )
                log_action(
                    "adaptive_assignment_completed" if sample.success else "adaptive_assignment_failed",
                    {
                        "run_id": industrial_run_id,
                        "lane": os.getenv("YTIS_NLM_LANE", ""),
                        "assignment_id": assignment_id,
                        "worker_id": f"worker-{slot_id:02d}",
                        "target_workers": adaptive_scheduler.target_workers,
                        "active_workers": len(industrial_worker_futures),
                        "queued_batches": len(industrial_batch_queue),
                        "reason": "result_recorded" if sample.success else sample.failure_kind,
                        "policy_version": "adaptive-worker-scheduler-v1",
                        "timestamp_monotonic_s": time.monotonic(),
                        "batch_ids": batch_ids,
                        **_adaptive_accounting_payload(),
                        "terminal_failed": not sample.success and not requeue_assignment,
                        "requeued": requeue_assignment,
                    },
                )
            if failed and not requeue_assignment:
                fallback_queued = _route_worker_failures_to_fallback(worker_payload)
                if fallback_queued:
                    # The worker's failed count is provisional until the
                    # explicitly routed fallback finishes. Keep final counts
                    # reconciled to the selected DB rows.
                    fail_count -= fallback_queued
                    transcript_fallback_processed_count += fallback_queued
            total_commands = max(succeeded + failed, 1)
            industrial_worker_slot_health[slot_id] = {
                "source_list_probe_count": float(summary.get("source_list_probe_count", 0) or 0.0),
                "source_list_probe_elapsed_s_total": float(
                    summary.get("source_list_probe_elapsed_s_total", 0.0) or 0.0
                ),
                "content_fetch_command_elapsed_s_avg": float(
                    summary.get("content_fetch_command_elapsed_s_avg", 0.0) or 0.0
                ),
                "failure_rate": failed / total_commands,
                "avg_elapsed_s": elapsed_s / max(video_count, 1),
            }
            if industrial_first_worker_finished_at is None:
                industrial_first_worker_finished_at = time.monotonic() - fetch_started_at
            industrial_last_worker_finished_at = time.monotonic() - fetch_started_at
            industrial_completion_stall_alert_logged = False
            _add_worker_stage_totals(summary)
            if not industrial_oversized_dispatch_alert_logged and (
                batch_count > industrial_batches_per_worker
                or video_count > batch_size * industrial_batches_per_worker
            ):
                industrial_oversized_dispatch_alert_logged = True
                _log_worker_health_warning(
                    "oversized_worker_dispatch",
                    worker_id=f"worker-{slot_id:02d}",
                    batch_count=batch_count,
                    video_count=video_count,
                    batch_size=batch_size,
                    batches_per_worker=industrial_batches_per_worker,
                )
            log_action(
                "fetch_worker_dispatch_finished",
                {
                    "worker_id": f"worker-{slot_id:02d}",
                    "batch_count": batch_count,
                    "video_count": video_count,
                    "succeeded": succeeded,
                    "failed": failed,
                },
            )

        target_workers = adaptive_scheduler.target_workers if adaptive_scheduler is not None else workers
        if adaptive_scheduler is not None:
            recovery_now_s = time.monotonic() - fetch_started_at
            recovered_workers = adaptive_scheduler.recover_quarantined(now_s=recovery_now_s)
            for transition in recovered_workers:
                log_action(
                    "adaptive_worker_recovered",
                    {
                        "run_id": industrial_run_id,
                        "lane": os.getenv("YTIS_NLM_LANE", ""),
                        "worker_id": f"worker-{transition.worker_id:02d}",
                        "target_workers": transition.target_workers,
                        "active_workers": len(industrial_worker_futures),
                        "queued_batches": len(industrial_batch_queue),
                        "reason": transition.reason,
                        "policy_version": "adaptive-worker-scheduler-v1",
                        "timestamp_monotonic_s": recovery_now_s,
                    },
                )
            decision = adaptive_scheduler.choose(
                SchedulerSnapshot(
                    now_s=time.monotonic() - fetch_started_at,
                    backlog_batches=len(industrial_batch_queue),
                    active_worker_ids=frozenset(industrial_worker_slots_in_use.values()),
                    health_samples=tuple(industrial_worker_health_samples),
                    input_closed=input_closed,
                )
            )
            transitions = adaptive_scheduler.apply(decision, now_s=time.monotonic() - fetch_started_at)
            target_workers = adaptive_scheduler.target_workers
            log_action(
                "adaptive_scale_decision",
                {
                    "run_id": industrial_run_id,
                    "lane": os.getenv("YTIS_NLM_LANE", ""),
                    "worker_id": "coordinator",
                    "target_workers": target_workers,
                    "active_workers": len(industrial_worker_futures),
                    "queued_batches": len(industrial_batch_queue),
                    "decision_reason": decision.reason,
                    "reason": decision.reason,
                    "policy_version": "adaptive-worker-scheduler-v1",
                    "timestamp_monotonic_s": time.monotonic(),
                    "changed": decision.changed,
                    "input_closed": input_closed,
                },
            )
            for transition in transitions:
                if transition.event == "worker_draining":
                    log_action(
                        "adaptive_worker_draining",
                        {
                            "run_id": industrial_run_id,
                            "lane": os.getenv("YTIS_NLM_LANE", ""),
                            "worker_id": f"worker-{transition.worker_id:02d}",
                            "target_workers": transition.target_workers,
                            "active_workers": len(industrial_worker_futures),
                            "queued_batches": len(industrial_batch_queue),
                            "reason": transition.reason,
                            "policy_version": "adaptive-worker-scheduler-v1",
                            "timestamp_monotonic_s": transition.now_s,
                        },
                    )
        available_slots = max(0, target_workers - len(industrial_worker_futures))
        if adaptive_scheduler is not None:
            free_slots = [
                slot_id
                for slot_id in adaptive_scheduler.eligible_worker_ids()
                if slot_id not in industrial_worker_slots_in_use.values()
            ]
        else:
            free_slots = [
                slot_id
                for slot_id in range(1, workers + 1)
                if slot_id not in industrial_worker_slots_in_use.values()
            ]
        free_slots = _order_industrial_free_slots(free_slots, industrial_worker_slot_health)
        if adaptive_scheduler is not None and industrial_batch_queue and not free_slots and not industrial_worker_futures:
            queued_batch_ids = [item.batch_id for item in industrial_batch_queue]
            queued_video_count = sum(len(item.video_ids) for item in industrial_batch_queue)
            failure_reason_counts = Counter(
                sample.failure_kind
                for sample in industrial_worker_health_samples
                if not sample.success and sample.failure_kind
            )
            exhaustion_payload = {
                "run_id": industrial_run_id,
                "lane": os.getenv("YTIS_NLM_LANE", ""),
                "worker_id": "coordinator",
                "target_workers": adaptive_scheduler.target_workers,
                "min_workers": adaptive_scheduler.config.min_workers,
                "max_workers": adaptive_scheduler.config.max_workers,
                "active_workers": 0,
                "queued_batch_count": len(queued_batch_ids),
                "queued_batch_ids": queued_batch_ids,
                "queued_video_count": queued_video_count,
                "eligible_worker_ids": list(adaptive_scheduler.eligible_worker_ids()),
                "failure_reason_counts": dict(failure_reason_counts),
                "policy_version": "adaptive-worker-scheduler-v1",
                "timestamp_monotonic_s": time.monotonic(),
                "reason": "no_eligible_worker_slots",
                "assignment_accounting": _adaptive_accounting_payload(),
            }
            selection_metadata["adaptive_scheduler_exhaustion"] = exhaustion_payload
            log_action(
                "adaptive_scheduler_exhausted",
                exhaustion_payload,
            )
            _log_fetch_terminal_failure(
                "adaptive_scheduler_exhausted:no_eligible_worker_slots"
            )
            raise AdaptiveSchedulerExhausted(exhaustion_payload)
        log_action(
            "fetch_worker_dispatch_state",
            {
                "workers_requested": target_workers,
                "active_workers": len(industrial_worker_futures),
                "free_slots": len(free_slots),
                "queued_batches": len(industrial_batch_queue),
                "available_slots": available_slots,
                "first_worker_finished_at": industrial_first_worker_finished_at,
                "last_worker_finished_at": industrial_last_worker_finished_at,
                "wait_for_completion": wait_for_completion,
                "input_closed": input_closed,
            },
        )
        if (
            not industrial_completion_stall_alert_logged
            and (industrial_worker_futures or industrial_batch_queue)
            and time.monotonic() - fetch_started_at >= 900
        ):
            if industrial_last_worker_finished_at is None:
                industrial_completion_stall_alert_logged = True
                _log_worker_health_warning("no_worker_completion_after_15m")
            else:
                stalled_for_s = time.monotonic() - fetch_started_at - industrial_last_worker_finished_at
                if stalled_for_s >= 900:
                    industrial_completion_stall_alert_logged = True
                    _log_worker_health_warning(
                        "no_worker_completion_after_15m_since_last_completion",
                    )
        dispatch_slots = _bounded_dispatch_slot_count(available_slots, len(free_slots))
        if dispatch_slots <= 0 or not industrial_batch_queue:
            return

        worker_groups = _take_industrial_dispatch_groups(
            industrial_batch_queue,
            dispatch_slots,
            industrial_batches_per_worker,
            rotate_by=industrial_dispatch_cycle,
        )
        if not worker_groups:
            return

        if industrial_worker_executor is None:
            industrial_worker_executor = ThreadPoolExecutor(
                max_workers=adaptive_scheduler.config.max_workers if adaptive_scheduler is not None else workers
            )

        total_batches = sum(len(group) for group in worker_groups)
        print(
            f"[source] Parallel industrial dispatch: {total_batches} batches "
            f"across {len(worker_groups)} workers..."
        )
        log_action(
            "fetch_worker_dispatch_started",
            {
                "workers": len(worker_groups),
                "batch_count": total_batches,
                "video_count": sum(
                    len(item.video_ids)
                    for group in worker_groups
                    for item in group
                ),
                "industrial_batches_per_worker": industrial_batches_per_worker,
                "state_root": os.getenv(
                    "YTIS_INDUSTRIAL_WORKER_STATE_ROOT",
                    "P:/.data/yt-is/industrial-worker-states",
                ),
                "streaming": True,
            },
        )

        for slot_id, worker_queue_items in zip(free_slots, worker_groups):
            worker_batches = [item.video_ids for item in worker_queue_items]
            assignment_id = uuid.uuid4().hex if adaptive_scheduler is not None else ""
            if adaptive_scheduler is not None:
                batch_ids = [item.batch_id for item in worker_queue_items]
                if adaptive_assignment_ledger is not None:
                    adaptive_assignment_ledger.claim(assignment_id, tuple(batch_ids))
                log_action(
                    "adaptive_worker_starting",
                    {
                        "run_id": industrial_run_id,
                        "lane": os.getenv("YTIS_NLM_LANE", ""),
                        "worker_id": f"worker-{slot_id:02d}",
                        "target_workers": adaptive_scheduler.target_workers,
                        "active_workers": len(industrial_worker_futures),
                        "queued_batches": len(industrial_batch_queue),
                        "reason": "eligible_slot",
                        "policy_version": "adaptive-worker-scheduler-v1",
                        "timestamp_monotonic_s": time.monotonic(),
                        "assignment_id": assignment_id,
                        "batch_ids": batch_ids,
                        **_adaptive_accounting_payload(),
                    },
                )
                adaptive_scheduler.mark_started(
                    slot_id,
                    now_s=time.monotonic() - fetch_started_at,
                    assignment_id=assignment_id,
                )
            try:
                future = industrial_worker_executor.submit(
                    _run_industrial_worker,
                    slot_id,
                    worker_batches,
                )
            except Exception as exc:
                if adaptive_scheduler is None:
                    raise
                adaptive_scheduler.mark_failed(
                    slot_id,
                    now_s=time.monotonic() - fetch_started_at,
                    assignment_id=assignment_id,
                    failure_kind="launch_failure",
                )
                log_action(
                    "adaptive_worker_quarantined",
                    {
                        "run_id": industrial_run_id,
                        "lane": os.getenv("YTIS_NLM_LANE", ""),
                        "worker_id": f"worker-{slot_id:02d}",
                        "target_workers": adaptive_scheduler.target_workers,
                        "active_workers": len(industrial_worker_futures),
                        "queued_batches": len(industrial_batch_queue),
                        "reason": "launch_failure",
                        "policy_version": "adaptive-worker-scheduler-v1",
                        "timestamp_monotonic_s": time.monotonic(),
                    },
                )
                _requeue_adaptive_assignment(
                    industrial_batch_queue,
                    worker_queue_items,
                    adaptive_assignment_ledger,
                    assignment_id,
                )
                log_action(
                    "adaptive_assignment_failed",
                    {
                        "run_id": industrial_run_id,
                        "lane": os.getenv("YTIS_NLM_LANE", ""),
                        "assignment_id": assignment_id,
                        "worker_id": f"worker-{slot_id:02d}",
                        "target_workers": adaptive_scheduler.target_workers,
                        "active_workers": len(industrial_worker_futures),
                        "queued_batches": len(industrial_batch_queue),
                        "reason": "launch_failure",
                        "policy_version": "adaptive-worker-scheduler-v1",
                        "timestamp_monotonic_s": time.monotonic(),
                        "batch_ids": batch_ids,
                        **_adaptive_accounting_payload(),
                        "requeued": True,
                        "error": repr(exc),
                    },
                )
                continue
            industrial_worker_futures.add(future)
            industrial_worker_slots_in_use[future] = slot_id
            # Keep the logical batch payload for every worker mode.  The
            # opt-in industrial-failure fallback reconciles exact IDs after a
            # normal worker result; it must not depend on adaptive scheduling
            # being enabled.
            industrial_worker_assignment_payloads[future] = worker_queue_items
            if adaptive_scheduler is not None:
                industrial_worker_assignment_ids[future] = assignment_id
                industrial_worker_assignment_batches[future] = batch_ids
                log_action(
                    "adaptive_worker_started",
                    {
                        "run_id": industrial_run_id,
                        "lane": os.getenv("YTIS_NLM_LANE", ""),
                        "worker_id": f"worker-{slot_id:02d}",
                        "target_workers": adaptive_scheduler.target_workers,
                        "active_workers": len(industrial_worker_futures),
                        "queued_batches": len(industrial_batch_queue),
                        "reason": "launch_accepted",
                        "policy_version": "adaptive-worker-scheduler-v1",
                        "timestamp_monotonic_s": time.monotonic(),
                        "assignment_id": assignment_id,
                        "batch_ids": industrial_worker_assignment_batches[future],
                        **_adaptive_accounting_payload(),
                    },
                )
                log_action(
                    "adaptive_assignment_claimed",
                    {
                        "run_id": industrial_run_id,
                        "lane": os.getenv("YTIS_NLM_LANE", ""),
                        "assignment_id": assignment_id,
                        "worker_id": f"worker-{slot_id:02d}",
                        "target_workers": adaptive_scheduler.target_workers,
                        "active_workers": len(industrial_worker_futures),
                        "queued_batches": len(industrial_batch_queue),
                        "reason": "eligible_slot",
                        "policy_version": "adaptive-worker-scheduler-v1",
                        "timestamp_monotonic_s": time.monotonic(),
                        "batch_count": len(worker_batches),
                        "video_count": sum(len(batch) for batch in worker_batches),
                        "batch_ids": industrial_worker_assignment_batches[future],
                        **_adaptive_accounting_payload(),
                    },
                )
        industrial_dispatch_cycle += 1

    def _process_industrial_batch(batch_items: list[tuple[str, str]]) -> None:
        nonlocal industrial_batches_processed, success_count, fail_count, transcript_fallback_queue, transcript_fallback_processed_count
        if not batch_items:
            return
        batch_started_at = time.perf_counter()
        industrial_batches_processed += 1
        batch = [vid for vid, _ in batch_items]
        source_map = {vid: source_url for vid, source_url in batch_items}
        print(
            f"[source] Processing batch {industrial_batches_processed} "
            f"({len(batch)} videos) via direct NotebookLM batch..."
        )
        _log_first_download_started(
            "industrial_cli_batch",
            batch_index=industrial_batches_processed,
            batch_size=len(batch),
            first_video_id=batch[0],
        )
        results = process_industrial_batch_reusable(batch)
        batch_elapsed = time.perf_counter() - batch_started_at
        for vid, (success, transcript, error) in results.items():
                if success and transcript:
                    set_cached_transcript(
                        vid,
                        "en",
                        "notebooklm",
                        transcript,
                        metadata={
                            "pipeline": "csf-source",
                            "route": "industrial_cli_batch",
                            "source_url": source_map.get(vid, ""),
                            "batch_index": industrial_batches_processed,
                            "batch_size": len(batch),
                            "batch_elapsed_s": round(batch_elapsed, 3),
                            "per_video_s": round(batch_elapsed / max(len(batch), 1), 3),
                        },
                    )
                    # Stage timing: record per-video elapsed for the batch path
                    try:
                        from csf.transcript import _record_stage_timing
                        _record_stage_timing(
                            vid, "notebooklm",
                            batch_elapsed / max(len(batch), 1),
                            True, False,
                        )
                    except Exception:
                        pass
                    mark_complete(vid, last_stage="notebooklm")
                    success_count += 1
                    print(f"  ✓ {vid} (notebooklm)")
                else:
                    fail_count += 1
                    print(f"  ✗ {vid}: {error[:80]}")
                    source_url = source_map.get(vid, "")
                    route_to_fallback = (
                        route_industrial_failures_to_fallback
                        or (
                            route_source_add_failures_to_fallback
                            and _is_source_add_failure_reason(error)
                        )
                        or (
                            route_source_addressability_failures_to_fallback
                            and _is_source_addressability_failure_reason(error)
                        )
                    )
                    if source_url and transcript_fallback_workers > 0 and route_to_fallback:
                        if _queue_transcript_fallback(vid, source_url, True, error):
                            log_action(
                                "transcript_fallback_queued",
                                {
                                    "video_id": vid,
                                    "source_url": source_url,
                                    "reason": error[:120],
                                    "queue_depth": len(transcript_fallback_queue),
                                    "durable": durable_fallback_queue is not None,
                                },
                            )
                            transcript_fallback_processed_count += 1
                    elif source_url:
                        log_action(
                            "transcript_fallback_disabled",
                            {
                                "video_id": vid,
                                "source_url": source_url,
                                "reason": error[:120],
                                "transcript_fallback_workers": transcript_fallback_workers,
                            },
                        )

    def _process_transcript_fallback(
        video_id: str,
        source_url: str,
        skip_notebooklm: bool,
    ) -> tuple[str, bool, str, str, str]:
        """Process a fallback video via the transcript chain."""
        if has_cached_transcript(video_id):
            return (video_id, True, "cache", "", "")
        nonlocal transcript_fallback_last_start_at
        with transcript_fallback_start_lock:
            next_start_at = max(
                time.monotonic(),
                transcript_fallback_last_start_at + transcript_fallback_min_start_interval_s,
            )
            transcript_fallback_last_start_at = next_start_at
        wait_s = next_start_at - time.monotonic()
        if wait_s > 0:
            time.sleep(wait_s)
        log_action(
            "transcript_fallback_started",
            {
                "video_id": video_id,
                "source_url": source_url,
                "queue_depth": len(transcript_fallback_queue),
                "transcript_fallback_workers": transcript_fallback_workers,
                "min_start_interval_s": transcript_fallback_min_start_interval_s,
                "skip_notebooklm": skip_notebooklm,
            },
        )
        _log_first_download_started(
            "transcript_fallback",
            video_id=video_id,
            source_url=source_url,
        )
        admission_metadata = None
        try:
            for entry in get_entries_for_source_details(source_url):
                if str(entry.get("video_id")) == video_id:
                    admission_metadata = {
                        "title": entry.get("title"),
                        "description": entry.get("description"),
                        "duration": entry.get("duration"),
                        "privacy_status": entry.get("privacy_status"),
                        "upload_status": entry.get("upload_status"),
                        "is_live_content": entry.get("is_live_content"),
                        "unavailable_reason": entry.get("unavailable_reason"),
                    }
                    break
        except Exception:
            admission_metadata = None
        config = LanguageConfig(prefer_lang="en", allow_translation=False)
        skip_oembed = fallback_only or route_no_captions_to_fallback
        timeout_s = _transcript_fallback_timeout_s()
        if timeout_s is None:
            result = fetch_transcript_chain(
                video_id, config, skip_notebooklm=skip_notebooklm,
                skip_oembed=skip_oembed, admission_metadata=admission_metadata,
            )
        else:
            result = _run_transcript_fallback_subprocess(
                video_id, skip_notebooklm, skip_oembed, admission_metadata, timeout_s,
            )
        if result.transcript:
            set_cached_transcript(
                video_id,
                result.lang or "en",
                result.source,
                result.transcript,
                metadata=build_transcript_cache_metadata(
                    result,
                    extra={
                        "pipeline": "csf-source",
                        "route": "transcript_fallback",
                        "source_url": source_url,
                        "skip_notebooklm": skip_notebooklm,
                    },
                ),
            )
            mark_complete(
                video_id,
                last_stage=result.source or "transcript_fallback",
                quality_metrics=_build_result_quality_metrics(result),
            )
            log_action(
                "transcript_fallback_completed",
                {
                    "video_id": video_id,
                    "source_url": source_url,
                    "status": "success",
                    "source": result.source or "transcript_fallback",
                    "lang": result.lang or "en",
                    "chars": len(result.transcript),
                },
            )
            return (video_id, True, result.source or "transcript_fallback", result.transcript, "")
        failure_reason = result.failure_reason or "unknown"
        last_stage = result.last_stage or "transcript_fallback"
        error_text = result.error or "No transcript available"
        original_failure_reason = transcript_fallback_original_failure_reasons.get(video_id)
        persisted_failure = _compose_fallback_failure_reason(
            original_failure_reason,
            failure_reason,
            error_text,
        )
        status_persisted = False
        try:
            set_status(
                video_id,
                "failed",
                last_stage=last_stage,
                failure_reason=persisted_failure,
            )
            status_persisted = True
        except Exception as exc:
            log_action(
                "transcript_fallback_status_persist_failed",
                {
                    "video_id": video_id,
                    "source_url": source_url,
                    "error": f"{type(exc).__name__}: {exc}",
                    "failure_reason": persisted_failure,
                },
            )
        log_action(
            "transcript_fallback_completed",
            {
                "video_id": video_id,
                "source_url": source_url,
                "status": "failed",
                "failure_reason": failure_reason,
                "original_failure_reason": original_failure_reason,
                "persisted_failure_reason": persisted_failure,
                "last_stage": last_stage,
                "error": error_text,
                "status_persisted": status_persisted,
            },
        )
        return (video_id, False, "", "", f"[{failure_reason} @ {last_stage}] {error_text}")

    def _service_transcript_fallback_workers(wait_for_completion: bool = False) -> None:
        nonlocal transcript_fallback_queue, transcript_fallback_worker_executor, transcript_fallback_worker_futures
        nonlocal transcript_fallback_worker_seq, success_count, fail_count

        def _claim(video_id: str) -> bool:
            if durable_fallback_queue is None:
                return True
            claimed = durable_fallback_queue.claim(
                claimant_id=durable_fallback_claimant_id,
                video_id=video_id,
                limit=1,
            )
            if claimed:
                return True
            log_action(
                "transcript_fallback_durable_claim_skipped",
                {"video_id": video_id, "reason": "record_not_queued"},
            )
            return False

        def _finalize(video_id: str, success: bool, error: str) -> None:
            if durable_fallback_queue is None:
                transcript_fallback_original_failure_reasons.pop(video_id, None)
                return
            try:
                if success:
                    completed = durable_fallback_queue.complete(
                        video_id,
                        claimant_id=durable_fallback_claimant_id,
                    )
                else:
                    original_failure_reason = transcript_fallback_original_failure_reasons.get(video_id)
                    failure = (
                        _compose_fallback_failure_reason(
                            original_failure_reason,
                            "transcript_fallback",
                            error or "transcript_fallback_failed",
                        )
                        if original_failure_reason
                        else (error or "transcript_fallback_failed")[:1000]
                    )
                    completed = durable_fallback_queue.fail(
                        video_id,
                        claimant_id=durable_fallback_claimant_id,
                        failure_reason=failure,
                    )
                if not completed:
                    log_action(
                        "transcript_fallback_durable_finalize_failed",
                        {
                            "video_id": video_id,
                            "success": success,
                            "reason": "claimant_or_state_mismatch",
                        },
                    )
            finally:
                transcript_fallback_original_failure_reasons.pop(video_id, None)

        if transcript_fallback_workers <= 0:
            while transcript_fallback_queue:
                video_id, source_url, _skip_notebooklm = transcript_fallback_queue.popleft()
                transcript_fallback_memory_ids.discard(video_id)
                if not _claim(video_id):
                    continue
                _finalize(video_id, False, "transcript fallback disabled")
                fail_count += 1
                log_action(
                    "transcript_fallback_skipped_disabled",
                    {
                        "video_id": video_id,
                        "source_url": source_url,
                        "transcript_fallback_workers": transcript_fallback_workers,
                    },
                )
            return

        if wait_for_completion and transcript_fallback_worker_futures:
            done, _ = wait(transcript_fallback_worker_futures, return_when=FIRST_COMPLETED)
        else:
            done, _ = wait(transcript_fallback_worker_futures, timeout=0, return_when=FIRST_COMPLETED)

        for future in done:
            transcript_fallback_worker_futures.remove(future)
            video_id, success, source, transcript, error = future.result()
            _finalize(video_id, bool(success and transcript), error)
            if success and transcript:
                success_count += 1
                print(f"  ✓ {video_id} ({source})")
            else:
                fail_count += 1
                print(f"  ✗ {video_id}: {error[:80]}")

        available_slots = max(0, workers - len(transcript_fallback_worker_futures))
        if available_slots <= 0 or not transcript_fallback_queue:
            return

        if transcript_fallback_worker_executor is None:
            transcript_fallback_worker_executor = ThreadPoolExecutor(max_workers=transcript_fallback_workers)

        submit_count = min(
            max(0, transcript_fallback_workers - len(transcript_fallback_worker_futures)),
            len(transcript_fallback_queue),
        )
        for _ in range(submit_count):
            video_id, source_url, skip_notebooklm = transcript_fallback_queue[0]
            if not _claim(video_id):
                transcript_fallback_queue.popleft()
                transcript_fallback_memory_ids.discard(video_id)
                continue
            transcript_fallback_queue.popleft()
            transcript_fallback_memory_ids.discard(video_id)
            transcript_fallback_worker_seq += 1
            worker_label = f"transcript-fallback-{transcript_fallback_worker_seq:02d}"
            future = transcript_fallback_worker_executor.submit(
                _process_transcript_fallback,
                video_id,
                source_url,
                skip_notebooklm,
            )
            transcript_fallback_worker_futures.add(future)

    def _primary_pending_discovered_total() -> int:
        return max(0, pending_discovered_total - int(shared_retry_processed_count_total))

    selection_result = None
    if selection_manifest is not None:
        manifest_ids = [item.video_id for item in selection_manifest.items]
        manifest_rows = get_entries_for_video_ids_details(manifest_ids)
        rows_by_video_id = {
            str(row["video_id"]): row
            for row in manifest_rows
            if row.get("video_id") is not None
        }
        selection_result = select_manifest_entries(
            selection_manifest,
            rows_by_video_id,
            max_items=max_items,
        )
        selection_metadata["selection_fingerprint"] = selection_result.fingerprint
        if receipt_to_verify is not None:
            verify_selection_receipt(
                receipt_to_verify,
                selection_manifest,
                selection_result,
            )
            selection_metadata["selection_receipt_verified"] = True
        if selection_receipt is not None:
            receipt = build_selection_receipt(
                selection_manifest,
                selection_result,
                manifest_path=video_manifest.resolve(),
                database_path=get_batch_db_path().resolve(),
                max_items=max_items,
                dry_run=dry_run,
            )
            write_selection_receipt(
                selection_receipt,
                receipt,
                overwrite=overwrite_selection_receipt,
            )
        _all_channel_entries = {
            "__video_manifest__": list(selection_result.selected_entries)
        }
        log_action(
            "fetch_manifest_selection",
            {
                "manifest_path": str(video_manifest),
                "manifest_fingerprint": selection_manifest.fingerprint,
                "selection_fingerprint": selection_result.fingerprint,
                "manifest_item_count": len(selection_manifest.items),
                "selected_count": len(selection_result.selected_entries),
                "missing_count": len(selection_result.missing_ids),
                "non_pending_count": sum(
                    len(ids) for ids in selection_result.non_pending_by_status.values()
                ),
                "limit_omitted_count": len(selection_result.limit_omitted_ids),
                "missing_sample": list(selection_result.missing_ids[:10]),
                "limit_omitted_sample": list(selection_result.limit_omitted_ids[:10]),
            },
        )
    else:
        # Snapshot isolation: read all channel entries with a single DB
        # connection so every channel sees the same database state under
        # concurrent writes.
        # Small test doubles historically exposed only the public lookup.
        # Keep that compatibility without weakening the real storage path.
        if hasattr(type(storage), "_query_entries_for_source_details"):
            _snapshot_conn = storage._get_conn()
            try:
                _all_channel_entries = {
                    _curl: storage._query_entries_for_source_details(_snapshot_conn, _curl)
                    for _curl, _ in channels
                }
            finally:
                _snapshot_conn.close()
        else:
            _all_channel_entries = {
                _curl: get_entries_for_source_details(_curl)
                for _curl, _ in channels
            }

    for channel_index, (channel_url, playlist_id) in enumerate(channels, start=1):
        pending_entries = _all_channel_entries.get(channel_url, [])
        for entry in pending_entries:
            video_id = str(entry["video_id"])
            status = str(entry["status"])
            if selection_manifest is not None:
                source_url = str(
                    entry.get("video_url")
                    or f"https://www.youtube.com/watch?v={video_id}"
                )
            else:
                source_url = str(entry.get("source") or channel_url)
            if status != "pending":
                continue
            if has_cached_transcript(video_id):
                cached_count += 1
                if len(cached_sample) < 10:
                    cached_sample.append(
                        {
                            "video_id": video_id,
                            "source": source_url,
                            "channel_index": channel_index,
                        }
                    )
                if not dry_run:
                    mark_complete(video_id, last_stage="cache")
                    log_action(
                        "transcript_cache_reconciled",
                        {
                            "video_id": video_id,
                            "source": source_url,
                            "last_stage": "cache",
                            "reason": "pending_row_has_usable_cached_transcript",
                        },
                    )
                continue
            neg_cache = get_negative_cache(video_id)
            if neg_cache:
                negative_cache_count += 1
                reason = str(neg_cache.get("reason") or "unknown").lower()
                negative_cache_reason_counts[reason] += 1
                if len(negative_cache_sample) < 10:
                    negative_cache_sample.append(
                        {
                            "video_id": video_id,
                            "source": source_url,
                            "channel_index": channel_index,
                            "reason": reason,
                            "last_stage": neg_cache.get("last_stage"),
                        }
                    )
                continue

            bucket, reason = _classify_pending_entry(entry)
            if bucket == "terminal":
                terminal_count += 1
                terminal_reason_counts[str(reason or "unavailable").lower()] += 1
                if len(terminal_sample) < 10:
                    terminal_sample.append(
                        {
                            "video_id": video_id,
                            "source": source_url,
                            "reason": reason or "unavailable",
                            "privacy_status": entry.get("privacy_status"),
                            "upload_status": entry.get("upload_status"),
                            "unavailable_reason": entry.get("unavailable_reason"),
                        }
                    )
                terminal_entries.append(
                    BatchEntry(
                        video_id=video_id,
                        status="failed",
                        source=source_url,
                        has_captions=entry.get("has_captions") if isinstance(entry.get("has_captions"), bool) else None,
                        duration=entry.get("duration") if isinstance(entry.get("duration"), int) else None,
                        privacy_status=entry.get("privacy_status") if isinstance(entry.get("privacy_status"), str) else None,
                        upload_status=entry.get("upload_status") if isinstance(entry.get("upload_status"), str) else None,
                        is_live_content=entry.get("is_live_content") if isinstance(entry.get("is_live_content"), bool) else None,
                        unavailable_reason=entry.get("unavailable_reason") if isinstance(entry.get("unavailable_reason"), str) else None,
                        failure_reason=f"terminal:{reason or 'unavailable'}",
                    )
                )
                continue
            pending_discovered_total += 1
            if bucket == "notebooklm":
                notebooklm_pending_count += 1
                industrial_source_urls[video_id] = source_url
                pending_buffer.append((video_id, source_url))
            else:
                if _queue_transcript_fallback(
                    video_id,
                    source_url,
                    True,
                    str(reason or "pending_fallback"),
                ):
                    transcript_fallback_queued_count += 1

            if not fallback_only and (
                notebooklm_pending_count >= backlog_threshold
                or transcript_fallback_queued_count >= backlog_threshold
            ):
                industrial_selected = True

            if not dry_run and industrial_selected and len(pending_buffer) >= batch_size:
                while len(pending_buffer) >= batch_size:
                    drained_batches = _drain_balanced_pending_batches(
                        pending_buffer,
                        batch_size=batch_size,
                        worker_count=adaptive_capacity if industrial_parallel_enabled else 1,
                        min_pending_batches=(
                            industrial_dispatch_min_pending_batches if industrial_parallel_enabled else 1
                        ),
                    )
                    if not drained_batches:
                        break
                    _enqueue_industrial_batches(
                        [[vid for vid, _src in batch_items] for batch_items in drained_batches]
                    )
                    if industrial_parallel_enabled:
                        _service_industrial_workers(
                            wait_for_completion=False,
                            input_closed=False,
                        )

            if industrial_parallel_enabled and industrial_worker_futures:
                _service_industrial_workers(
                    wait_for_completion=False,
                    input_closed=False,
                )

            if max_items is not None and _primary_pending_discovered_total() >= max_items:
                while (
                    shared_retry_pool_enabled
                    and industrial_parallel_enabled
                    and industrial_worker_futures
                    and _primary_pending_discovered_total() >= max_items
                ):
                    _service_industrial_workers(
                        wait_for_completion=True,
                        input_closed=True,
                    )
                if _primary_pending_discovered_total() < max_items:
                    continue
                max_items_reached = True
                break
        if max_items_reached:
            print(f"[source] Pending item limit reached at {pending_discovered_total}; stopping scan early.")
            log_action(
                "fetch_scan_limit_reached",
                {
                    "source_filter": source_filter,
                    "max_items": max_items,
                    "pending_discovered_total": pending_discovered_total,
                    "primary_pending_discovered_total": _primary_pending_discovered_total(),
                    "shared_retry_processed_count_total": shared_retry_processed_count_total,
                    "notebooklm_pending_count": notebooklm_pending_count,
                    "transcript_fallback_queued_count": transcript_fallback_queued_count,
                },
            )
            break

        if transcript_fallback_queue:
            _service_transcript_fallback_workers(wait_for_completion=False)

        elapsed_since_status = time.monotonic() - scan_last_status_at
        if channel_index == channel_count:
            _emit_scan_status(channel_index, "final_channel")
        elif elapsed_since_status >= scan_status_interval_s:
            _emit_scan_status(channel_index, "elapsed_interval")
        elif channel_index == 1:
            _emit_scan_status(channel_index, "first_channel")
        elif channel_index % scan_progress_interval == 0:
            _emit_scan_status(channel_index, "channel_checkpoint")

    if terminal_entries and not dry_run:
        set_status_batch(terminal_entries)
        print(f"[source] Marked {len(terminal_entries)} terminal videos as failed/skipped")
        log_action(
            "fetch_terminal_marked",
            {
                "count": len(terminal_entries),
                "sample": terminal_sample,
            },
        )

    log_action(
        "fetch_triage_summary",
        {
            "source_filter": source_filter,
            "channels_active_total": reported_channel_count,
            "pending_total": pending_discovered_total,
            "max_items": max_items,
            "max_items_reached": max_items_reached,
            "cached_total": cached_count,
            "cached_hit_rate": round(cached_count / (cached_count + pending_discovered_total + terminal_count), 4)
            if (cached_count + pending_discovered_total + terminal_count)
            else 0.0,
            "cached_sample": cached_sample,
            "negative_cache_count": negative_cache_count,
            "negative_cache_reason_counts": dict(negative_cache_reason_counts),
            "negative_cache_sample": negative_cache_sample,
            "terminal_count": terminal_count,
            "terminal_reason_counts": dict(terminal_reason_counts),
            "transcript_fallback_processed_count": transcript_fallback_processed_count,
            "transcript_fallback_queued_count": transcript_fallback_queued_count,
            "notebooklm_pending_count": notebooklm_pending_count,
            "industrial_batches_processed": industrial_batches_processed,
        },
    )

    total_pending = pending_discovered_total
    use_industrial = (
        industrial_selected
        or notebooklm_pending_count >= backlog_threshold
    )
    if notebooklm_pending_count > 0:
        strategy_name = "industrial_cli_batch" if use_industrial else "surgical_chain"
        backend_name = "notebooklm_cli_batch"
    elif transcript_fallback_queued_count > 0:
        strategy_name = "transcript_fallback_chain"
        backend_name = "yt_dlp_plus_selenium"
    else:
        strategy_name = "surgical_chain"
        backend_name = "yt_dlp_plus_selenium"
    deleted = 0
    failed = 0
    log_action(
        "fetch_scan_completed",
        {
            "source_filter": source_filter,
            "channels_tracked_total": reported_tracked_count,
            "channels_blocked_total": blocked_count,
            "channels_active_total": reported_channel_count,
            "pending_total": total_pending,
            "max_items": max_items,
            "max_items_reached": max_items_reached,
            "cached_total": cached_count,
            "cached_hit_rate": round(cached_count / (cached_count + total_pending + terminal_count), 4)
            if (cached_count + total_pending + terminal_count)
            else 0.0,
            "cached_sample": cached_sample,
            "negative_cache_count": negative_cache_count,
            "negative_cache_reason_counts": dict(negative_cache_reason_counts),
            "negative_cache_sample": negative_cache_sample,
            "terminal_count": terminal_count,
            "terminal_reason_counts": dict(terminal_reason_counts),
            "transcript_fallback_processed_count": transcript_fallback_processed_count,
            "transcript_fallback_queued_count": transcript_fallback_queued_count,
            "notebooklm_pending_count": notebooklm_pending_count,
            "elapsed_s": round(time.monotonic() - scan_started_at, 3),
            **selection_metadata,
        },
    )
    if selection_manifest is not None:
        print(
            f"[source] Preflight scan complete: {total_pending} manifest-selected pending items, "
            f"{cached_count} cached, {negative_cache_count} neg-cache, {terminal_count} terminal, "
            f"{notebooklm_pending_count} notebooklm, {transcript_fallback_queued_count} transcript-fallback"
        )
    else:
        print(
            f"[source] Preflight scan complete: {channel_count} active channels, "
            f"{total_pending} pending, {cached_count} cached, "
            f"{negative_cache_count} neg-cache, {terminal_count} terminal, {notebooklm_pending_count} notebooklm, "
            f"{transcript_fallback_queued_count} transcript-fallback"
        )
    if cached_sample:
        cached_ids = ", ".join(item["video_id"] for item in cached_sample)
        print(f"[source] Cached sample: {cached_ids}")
    if negative_cache_sample:
        neg_ids = ", ".join(item["video_id"] for item in negative_cache_sample)
        print(f"[source] Negative-cache sample: {neg_ids}")
    if not dry_run and industrial_selected and pending_buffer:
        while len(pending_buffer) >= batch_size:
            drained_batches = _drain_balanced_pending_batches(
                pending_buffer,
                batch_size=batch_size,
                worker_count=adaptive_capacity if industrial_parallel_enabled else 1,
                min_pending_batches=1,
            )
            if not drained_batches:
                break
            _enqueue_industrial_batches(
                [[vid for vid, _src in batch_items] for batch_items in drained_batches]
            )
        if pending_buffer:
            _enqueue_industrial_batches([[vid for vid, _src in pending_buffer]])
            pending_buffer.clear()
    if industrial_parallel_enabled:
        _service_industrial_workers(
            wait_for_completion=False,
            input_closed=True,
        )
    print(f"[source] Escalation Batch Process")
    if selection_manifest is not None:
        print(f"[source] Manifest items: {len(selection_manifest.items)} selected from manifest")
    else:
        print(f"[source] Channels: {channel_count} active / {tracked_count} tracked")
    print(f"[source] Already cached: {cached_count}")
    if cached_sample:
        cached_ids = ", ".join(item["video_id"] for item in cached_sample)
        print(f"[source] Cached sample: {cached_ids}")
    print(f"[source] Negative-cache skips: {negative_cache_count}")
    if negative_cache_sample:
        neg_ids = ", ".join(item["video_id"] for item in negative_cache_sample)
        print(f"[source] Negative-cache sample: {neg_ids}")
    print(f"[source] Pending extraction: {total_pending}")
    if max_items is not None:
        print(f"[source] Run limit: {max_items} pending items")
    print(f"[source] Mode: {'DRY RUN' if dry_run else 'LIVE'}")
    if dry_run:
        print("[source] Dry run complete. Use without --dry-run to fetch transcripts.")
        _log_fetch_completed(
            source_filter=source_filter,
            strategy=strategy_name,
            backend=backend_name,
            backlog_threshold=backlog_threshold,
            batch_size=batch_size,
            max_items=max_items,
            workers=workers,
            channels_tracked_total=reported_tracked_count,
            channels_blocked_total=blocked_count,
            channels_active_total=reported_channel_count,
            pending_total=total_pending,
            cached_total=cached_count,
            cached_hit_rate=round(cached_count / (cached_count + total_pending + terminal_count), 4)
            if (cached_count + total_pending + terminal_count)
            else 0.0,
            cached_sample=cached_sample,
            negative_cache_count=negative_cache_count,
            negative_cache_reason_counts=dict(negative_cache_reason_counts),
            negative_cache_sample=negative_cache_sample,
            route_no_captions_to_fallback=route_no_captions_to_fallback,
            industrial_batches_processed=industrial_batches_processed,
            notebooklm_pending_count=notebooklm_pending_count,
            transcript_fallback_processed_count=transcript_fallback_processed_count,
            transcript_fallback_queued_count=transcript_fallback_queued_count,
            terminal_count=terminal_count,
            terminal_reason_counts=dict(terminal_reason_counts),
            worker_cleanup_deleted=deleted,
            worker_cleanup_failed=failed,
            success_count=success_count,
            fail_count=fail_count,
            skip_count=skip_count,
            elapsed_s=round(time.monotonic() - fetch_started_at, 3),
            status="dry_run",
            selection_metadata=selection_metadata,
            worker_source_profile_totals=_build_worker_source_profile_totals_payload(),
        )
        return
    use_industrial = (
        industrial_selected
        or notebooklm_pending_count >= backlog_threshold
    )
    if notebooklm_pending_count > 0:
        strategy_name = "industrial_cli_batch" if use_industrial else "surgical_chain"
        backend_name = "notebooklm_cli_batch"
    elif transcript_fallback_queued_count > 0:
        strategy_name = "transcript_fallback_chain"
        backend_name = "yt_dlp_plus_selenium"
    else:
        strategy_name = "surgical_chain"
        backend_name = "yt_dlp_plus_selenium"
    log_action(
        "fetch_strategy_selected",
        {
            "source_filter": source_filter,
            "strategy": strategy_name,
            "backend": backend_name,
            "backlog_threshold": backlog_threshold,
            "batch_size": batch_size,
            "workers": workers,
            "channels_tracked_total": reported_tracked_count,
            "channels_blocked_total": blocked_count,
            "channels_active_total": reported_channel_count,
            "pending_total": total_pending,
            "cached_total": cached_count,
            "cached_hit_rate": round(cached_count / (cached_count + total_pending + terminal_count), 4)
            if (cached_count + total_pending + terminal_count)
            else 0.0,
            "cached_sample": cached_sample,
            "negative_cache_count": negative_cache_count,
            "negative_cache_reason_counts": dict(negative_cache_reason_counts),
            "negative_cache_sample": negative_cache_sample,
            "terminal_count": terminal_count,
            "terminal_reason_counts": dict(terminal_reason_counts),
            "industrial_selected": industrial_selected,
            "use_industrial": use_industrial,
            "notebooklm_pending_count": notebooklm_pending_count,
            "transcript_fallback_queued_count": transcript_fallback_queued_count,
            **selection_metadata,
        },
    )
    deleted = 0
    failed = 0
    if total_pending == 0:
        print("[source] All transcripts already cached. Nothing to do.")
        _log_fetch_completed(
            source_filter=source_filter,
            strategy=strategy_name,
            backend=backend_name,
            backlog_threshold=backlog_threshold,
            batch_size=batch_size,
            max_items=max_items,
            workers=workers,
            channels_tracked_total=reported_tracked_count,
            channels_blocked_total=blocked_count,
            channels_active_total=reported_channel_count,
            pending_total=total_pending,
            cached_total=cached_count,
            cached_hit_rate=round(cached_count / (cached_count + total_pending + terminal_count), 4)
            if (cached_count + total_pending + terminal_count)
            else 0.0,
            cached_sample=cached_sample,
            negative_cache_count=negative_cache_count,
            negative_cache_reason_counts=dict(negative_cache_reason_counts),
            negative_cache_sample=negative_cache_sample,
            route_no_captions_to_fallback=route_no_captions_to_fallback,
            industrial_batches_processed=industrial_batches_processed,
            notebooklm_pending_count=notebooklm_pending_count,
            transcript_fallback_processed_count=transcript_fallback_processed_count,
            transcript_fallback_queued_count=transcript_fallback_queued_count,
            terminal_count=terminal_count,
            terminal_reason_counts=dict(terminal_reason_counts),
            worker_cleanup_deleted=deleted,
            worker_cleanup_failed=failed,
            success_count=success_count,
            fail_count=fail_count,
            skip_count=skip_count,
            elapsed_s=round(time.monotonic() - fetch_started_at, 3),
            status="no_pending",
            selection_metadata=selection_metadata,
            worker_source_profile_totals=_build_worker_source_profile_totals_payload(),
        )
        return
    if notebooklm_pending_count > 0 and use_industrial:
        print("[source] Strategy: Industrial (Batch NLM)")
        print("[source] Method: direct NotebookLM batch for captioned/no-captions items; live items use transcript fallback")
    elif notebooklm_pending_count > 0:
        print("[source] Strategy: Surgical (Chain)")
        print("[source] Method: captioned/no-captions items use NotebookLM chain; live items use transcript fallback")
    elif transcript_fallback_queued_count > 0:
        print("[source] Strategy: Transcript Fallback")
        print("[source] Method: transcript fallback chain")
    else:
        print(
            f"[source] Strategy: {'Industrial (Batch NLM)' if use_industrial else 'Surgical (Chain)'}"
        )
        print("[source] Method: oEmbed → yt-dlp → yt-dlp+cookies → direct API → NotebookLM → Selenium → Whisper")
    print(f"[source] Workers: {workers}")
    print()

    if adaptive_scheduler is not None:
        log_action(
            "adaptive_scheduler_initialized",
            {
                "run_id": industrial_run_id,
                "lane": os.getenv("YTIS_NLM_LANE", ""),
                "worker_id": "coordinator",
                "target_workers": adaptive_scheduler.target_workers,
                "min_workers": adaptive_scheduler.config.min_workers,
                "initial_workers": adaptive_scheduler.config.initial_workers,
                "max_workers": adaptive_scheduler.config.max_workers,
                "scale_up_backlog": adaptive_scheduler.config.scale_up_backlog,
                "scale_down_backlog": adaptive_scheduler.config.scale_down_backlog,
                "cooldown_s": adaptive_scheduler.config.cooldown_s,
                "health_window": adaptive_scheduler.config.health_window,
                "max_failure_rate": adaptive_scheduler.config.max_failure_rate,
                "active_workers": 0,
                "queued_batches": len(industrial_batch_queue),
                "reason": "initial_target",
                "policy_version": "adaptive-worker-scheduler-v1",
                "timestamp_monotonic_s": time.monotonic(),
            },
        )

    if use_industrial and not dry_run:
        deleted, failed = cleanup_stale_worker_notebooks(delete=True, include_active=True)
        print(
            f"[source] Pre-flight worker notebook cleanup: {deleted} worker notebooks deleted, {failed} failed"
        )
        if failed:
            print(
                "[source] WARN: continuing despite pre-flight worker notebook cleanup failure "
                f"deleted={deleted} failed={failed}"
            )
        log_action(
            "fetch_worker_prewarm_summary",
            {
                "workers_requested": workers,
                "workers_active": workers,
                "batches": 0,
                "worker_slots": workers,
                "prewarm_expected": workers,
                "cleanup_deleted": deleted,
                "cleanup_failed": failed,
                "run_id": industrial_run_id,
                "state_root": os.getenv(
                    "YTIS_INDUSTRIAL_WORKER_STATE_ROOT",
                    "P:/.data/yt-is/industrial-worker-states",
                ),
                "streaming": True,
                "status": "planned",
            },
        )
    else:
        deleted = 0
        failed = 0

    def _industrial_parallel_enabled() -> bool:
        # Coordinator-owned children must cross the worker boundary even when
        # their configured worker count is one.  The in-process serial path
        # cannot receive the coordinator's account-scoped state path, notebook
        # title, or worker identity, and it also bypasses worker-level failure
        # persistence.  Preserve the historical direct path for standalone
        # callers that do not carry the coordinator ownership marker.
        return _industrial_parallel_enabled_for_runtime(workers=workers)

    def _split_batches_for_workers(batch_queue: list[list[str]], worker_count: int) -> list[list[list[str]]]:
        if worker_count < 1:
            raise ValueError("worker_count must be >= 1")
        if not batch_queue:
            return []
        effective_worker_count = min(worker_count, len(batch_queue))
        groups: list[list[list[str]]] = [[] for _ in range(effective_worker_count)]
        for idx, batch in enumerate(batch_queue):
            groups[idx % effective_worker_count].append(batch)
        return groups

    if use_industrial:
        # --- INDUSTRIAL PATH: direct NotebookLM batch content fetch ---
        # Group the backlog into batches and run them through isolated workers.
        post_deleted = 0
        post_failed = 0
        try:
            if transcript_fallback_queue:
                _service_transcript_fallback_workers(wait_for_completion=False)
            if dry_run:
                pass
            elif industrial_parallel_enabled:
                while industrial_batch_queue or industrial_worker_futures or transcript_fallback_queue or transcript_fallback_worker_futures:
                    _service_industrial_workers(
                        wait_for_completion=True,
                        input_closed=True,
                    )
                    _service_transcript_fallback_workers(wait_for_completion=True)
            else:
                while industrial_batch_queue:
                    queued_batch = industrial_batch_queue.pop(0)
                    _process_industrial_batch([(vid, "") for vid in queued_batch.video_ids])
                while transcript_fallback_queue or transcript_fallback_worker_futures:
                    _service_transcript_fallback_workers(wait_for_completion=True)
        finally:
            if industrial_worker_executor is not None:
                industrial_worker_executor.shutdown(wait=True, cancel_futures=False)
            if transcript_fallback_worker_executor is not None:
                transcript_fallback_worker_executor.shutdown(wait=True, cancel_futures=False)
            if durable_fallback_queue is not None:
                durable_fallback_queue.close()
            close_reusable_ingestor()
            if use_industrial and not dry_run:
                post_deleted, post_failed = cleanup_stale_worker_notebooks(delete=True, include_active=True)
                log_action(
                    "fetch_worker_postrun_cleanup",
                    {
                        "deleted": post_deleted,
                        "failed": post_failed,
                        "run_id": industrial_run_id,
                        "state_root": os.getenv(
                            "YTIS_INDUSTRIAL_WORKER_STATE_ROOT",
                            "P:/.data/yt-is/industrial-worker-states",
                        ),
                    },
                )
                if post_deleted or post_failed:
                    print(
                        f"[source] Post-run worker notebook cleanup: {post_deleted} worker notebooks deleted, "
                        f"{post_failed} failed"
                    )
                if post_failed:
                    raise RuntimeError(
                        f"worker notebook post-run cleanup failed: deleted={post_deleted} failed={post_failed}"
                    )

    else:
        # --- SURGICAL PATH: Sequential Escalation Chain ---
        all_pending = [(vid, src, False) for vid, src in pending_buffer]
        all_pending.extend(transcript_fallback_queue)
        transcript_fallback_queue.clear()
        transcript_fallback_memory_ids.clear()
        def _process_video(video_id: str, source_url: str, skip_notebooklm: bool) -> tuple[str, bool, str, str]:
            """Process a single video using the full transcript fallback chain."""
            durable_claimed = False
            if durable_fallback_queue is not None and skip_notebooklm:
                claimed = durable_fallback_queue.claim(
                    claimant_id=durable_fallback_claimant_id,
                    video_id=video_id,
                    limit=1,
                )
                if not claimed:
                    try:
                        prior = durable_fallback_queue.get(video_id)
                    except KeyError:
                        prior = None
                    if prior and prior["state"] == "completed":
                        return (video_id, True, "cache", "")
                    return (
                        video_id,
                        False,
                        "",
                        "[durable_queue @ claim] fallback record was not queued",
                    )
                durable_claimed = True
            if has_cached_transcript(video_id):
                transcript_fallback_original_failure_reasons.pop(video_id, None)
                if durable_claimed:
                    durable_fallback_queue.complete(
                        video_id,
                        claimant_id=durable_fallback_claimant_id,
                    )
                return (video_id, True, "cache", "")

            _log_first_download_started(
                "surgical",
                video_id=video_id,
                source_url=source_url,
            )
            config = LanguageConfig(prefer_lang="en", allow_translation=False)
            timeout_s = _transcript_fallback_timeout_s()
            if timeout_s is None:
                result = fetch_transcript_chain(
                    video_id,
                    config,
                    skip_notebooklm=skip_notebooklm,
                    skip_oembed=fallback_only,
                )
            else:
                result = _run_transcript_fallback_subprocess(
                    video_id,
                    skip_notebooklm,
                    fallback_only,
                    None,
                    timeout_s,
                )

            if result.transcript:
                set_cached_transcript(
                    video_id,
                    result.lang or "en",
                    result.source,
                    result.transcript,
                    metadata=build_transcript_cache_metadata(
                        result,
                        extra={
                            "pipeline": "csf-source",
                            "route": "surgical",
                            "source_url": source_url,
                            "skip_notebooklm": skip_notebooklm,
                        },
                    ),
                )
                mark_complete(
                    video_id,
                    last_stage=result.source,
                    quality_metrics=_build_result_quality_metrics(result),
                )
                if durable_claimed:
                    durable_fallback_queue.complete(
                        video_id,
                        claimant_id=durable_fallback_claimant_id,
                    )
                transcript_fallback_original_failure_reasons.pop(video_id, None)
                return (video_id, True, result.source, "")
            else:
                failure_reason = result.failure_reason or "unknown"
                last_stage = result.last_stage or "transcript_fallback"
                error_text = result.error or "No transcript available"
                persisted_failure = _compose_fallback_failure_reason(
                    transcript_fallback_original_failure_reasons.get(video_id),
                    failure_reason,
                    error_text,
                )
                set_status(
                    video_id,
                    "failed",
                    last_stage=last_stage,
                    failure_reason=persisted_failure,
                )
                if durable_claimed:
                    durable_fallback_queue.fail(
                        video_id,
                        claimant_id=durable_fallback_claimant_id,
                        failure_reason=persisted_failure,
                    )
                transcript_fallback_original_failure_reasons.pop(video_id, None)
                return (video_id, False, "", f"[{persisted_failure} @ {last_stage}] {error_text}")

        print(f"[source] Starting Surgical Ingest (Sequential Escalation)...")
        with ThreadPoolExecutor(max_workers=workers) as executor:
            futures = {
                executor.submit(_process_video, vid, src, skip_notebooklm): (idx, vid)
                for idx, (vid, src, skip_notebooklm) in enumerate(all_pending, 1)
            }
            for future in as_completed(futures):
                idx, video_id = futures[future]
                try:
                    video_id, success, source_used, error = future.result()
                    if success:
                        if source_used == "cache":
                            skip_count += 1
                        else:
                            success_count += 1
                            print(f"[{idx}/{total_pending}] ✓ {video_id} ({source_used})")
                    else:
                        fail_count += 1
                        print(f"[{idx}/{total_pending}] ✗ {video_id}: {error[:80]}")
                except Exception as e:
                    fail_count += 1
                    print(f"[{idx}/{total_pending}] ✗ Error: {e}")
        if durable_fallback_queue is not None:
            durable_fallback_queue.close()

    # Summary
    stage_totals = _build_worker_stage_totals_payload()
    print()
    print("[source] === Escalation Batch Complete ===")
    print(f"[source] Successfully extracted: {success_count}")
    print(f"[source] Failed: {fail_count}")
    print(f"[source] Skipped (cached): {skip_count}")
    print(f"[source] Skipped (negative cache): {negative_cache_count}")
    print(f"[source] Skipped (terminal): {terminal_count}")
    print(f"[source] NotebookLM-eligible: {notebooklm_pending_count}")
    print(f"[source] Routed to transcript fallback: {transcript_fallback_processed_count}")
    if terminal_reason_counts:
        top_terminal_reasons = ", ".join(
            f"{name}={count}" for name, count in terminal_reason_counts.most_common(5)
        )
        print(f"[source] Terminal reasons: {top_terminal_reasons}")
    if negative_cache_reason_counts:
        top_negative_reasons = ", ".join(
            f"{name}={count}" for name, count in negative_cache_reason_counts.most_common(5)
        )
        print(f"[source] Negative-cache reasons: {top_negative_reasons}")
    if use_industrial and not dry_run:
        print(f"[source] Worker notebook cleanup: {deleted} deleted, {failed} failed")
    if stage_totals["batch_elapsed_s_total"] > 0:
        print(
            "[source] Stage totals: "
            f"startup={stage_totals['startup_prepare_total_elapsed_s_total']:.1f}s, "
            f"setup={stage_totals['setup_elapsed_s_total']:.1f}s, "
            f"add={stage_totals['add_sources_elapsed_s_total']:.1f}s, "
            f"extract={stage_totals['extract_elapsed_s_total']:.1f}s, "
            f"cleanup={stage_totals['cleanup_elapsed_s_total']:.1f}s, "
            f"batch={stage_totals['batch_elapsed_s_total']:.1f}s"
        )
    worker_source_profile_totals = _build_worker_source_profile_totals_payload()
    if worker_source_profile_totals["total"] > 0:
        top_classes = sorted(
            worker_source_profile_totals["source_class_counts"].items(),
            key=lambda item: (-item[1], item[0]),
        )[:6]
        if top_classes:
            class_summary = ", ".join(f"{name}={count}" for name, count in top_classes)
            print(f"[source] Worker source profile: {class_summary}")
    elapsed_s = round(time.monotonic() - fetch_started_at, 3)
    processed_count = success_count + fail_count + skip_count
    print(f"[source] Total discovered: {total_pending}")
    print(f"[source] Total processed outcomes: {processed_count}")
    if adaptive_assignment_ledger is not None:
        selection_metadata["adaptive_assignment_accounting"] = _adaptive_accounting_payload()
    _log_fetch_completed(
        source_filter=source_filter,
        strategy=strategy_name,
        backend=backend_name,
        backlog_threshold=backlog_threshold,
        batch_size=batch_size,
        max_items=max_items,
        workers=workers,
        channels_tracked_total=reported_tracked_count,
        channels_blocked_total=blocked_count,
        channels_active_total=reported_channel_count,
        pending_total=total_pending,
        cached_total=cached_count,
        cached_hit_rate=round(cached_count / (cached_count + total_pending + terminal_count), 4)
        if (cached_count + total_pending + terminal_count)
        else 0.0,
        cached_sample=cached_sample,
        negative_cache_count=negative_cache_count,
        negative_cache_reason_counts=dict(negative_cache_reason_counts),
        negative_cache_sample=negative_cache_sample,
        route_no_captions_to_fallback=route_no_captions_to_fallback,
        industrial_batches_processed=industrial_batches_processed,
        notebooklm_pending_count=notebooklm_pending_count,
        transcript_fallback_processed_count=transcript_fallback_processed_count,
        transcript_fallback_queued_count=transcript_fallback_queued_count,
        terminal_count=terminal_count,
        terminal_reason_counts=dict(terminal_reason_counts),
        worker_cleanup_deleted=deleted,
        worker_cleanup_failed=failed,
        worker_stage_totals=stage_totals,
        worker_source_profile_totals=worker_source_profile_totals,
        success_count=success_count,
        fail_count=fail_count,
        skip_count=skip_count,
        elapsed_s=elapsed_s,
        status="completed",
        selection_metadata=selection_metadata,
    )


def _industrial_parallel_enabled_for_runtime(*, workers: int) -> bool:
    """Select the isolated industrial worker boundary for one fetch run."""
    if workers < 1:
        raise ValueError("workers must be >= 1")
    disable_flag = os.getenv("YTIS_DISABLE_INDUSTRIAL_PARALLEL", "").strip().lower()
    coordinator_owned = bool(os.getenv("YTIS_MULTI_ACCOUNT_FETCH_COORDINATOR_RUN_ID", "").strip())
    return (workers > 1 or coordinator_owned) and disable_flag not in {"1", "true", "yes", "on"}


def _resolve_industrial_run_id() -> str:
    """Use the coordinator identity when present, otherwise create a run id."""
    for environment_name in (
        "YTIS_INDUSTRIAL_RUN_ID",
        "YTIS_MULTI_ACCOUNT_FETCH_COORDINATOR_RUN_ID",
    ):
        value = os.getenv(environment_name, "").strip()
        if value:
            return value
    return uuid.uuid4().hex


def cmd_fetch(
    source_filter: str | None = None,
    dry_run: bool = False,
    workers: int = 1,
    max_items: int | None = None,
    video_manifest: Path | None = None,
    selection_receipt: Path | None = None,
    overwrite_selection_receipt: bool = False,
    verify_selection_receipt_path: Path | None = None,
    adaptive_workers: bool = False,
    adaptive_min_workers: int = 1,
    adaptive_max_workers: int | None = None,
    adaptive_scale_up_backlog: int = 2,
    adaptive_scale_down_backlog: int = 0,
    adaptive_cooldown_s: float = 60.0,
    adaptive_health_window: int = 2,
    fallback_only: bool = False,
    route_source_add_failures_to_fallback: bool = False,
    route_source_addressability_failures_to_fallback: bool = False,
) -> None:
    """Run one fetch under the database-scoped multi-launcher lock."""
    try:
        with fetch_run_lock(get_batch_db_path()):
            return _cmd_fetch_unlocked(
                source_filter=source_filter,
                dry_run=dry_run,
                workers=workers,
                max_items=max_items,
                video_manifest=video_manifest,
                selection_receipt=selection_receipt,
                overwrite_selection_receipt=overwrite_selection_receipt,
                verify_selection_receipt_path=verify_selection_receipt_path,
                adaptive_workers=adaptive_workers,
                adaptive_min_workers=adaptive_min_workers,
                adaptive_max_workers=adaptive_max_workers,
                adaptive_scale_up_backlog=adaptive_scale_up_backlog,
                adaptive_scale_down_backlog=adaptive_scale_down_backlog,
                adaptive_cooldown_s=adaptive_cooldown_s,
                adaptive_health_window=adaptive_health_window,
                fallback_only=fallback_only,
                route_source_add_failures_to_fallback=route_source_add_failures_to_fallback,
                route_source_addressability_failures_to_fallback=route_source_addressability_failures_to_fallback,
            )
    except FetchRunLockError as exc:
        print(f"[source] FATAL: {exc}", file=sys.stderr)
        raise SystemExit(2) from exc


def cmd_quota() -> None:
    """Print current per-key quota state and recommend workers."""
    quota = get_quota_status()
    if not quota:
        print("[source] No API keys configured.")
        return

    keys = _get_api_keys()
    print(f"API Keys: {len(keys)}")
    print(f"{'Key':<8} {'Calls':>6} {'Units':>8} {'Exhausted':>10} {'Since':<30}")
    print("-" * 70)
    for idx in sorted(quota.keys()):
        state = quota[idx]
        exhausted = "YES" if state["exhausted"] else "no"
        since = state.get("exhausted_at", "-")
        print(f"Key {idx:<3} {state['calls_made']:>6} {state['units_consumed']:>8} {exhausted:>10} {since or '-'}")

    total_exhausted = sum(1 for v in quota.values() if v.get("exhausted", False))
    total_units = sum(v["units_consumed"] for v in quota.values())
    remaining_per_key = 10000 - total_units // max(len(keys), 1)
    available = sum(10000 - v["units_consumed"] for v in quota.values() if not v.get("exhausted", False))

    # Recommend workers based on remaining non-exhausted keys
    non_exhausted = len(keys) - total_exhausted
    if total_exhausted >= len(keys):
        recommended_workers = 0
    elif non_exhausted == 1:
        recommended_workers = 1  # only one key alive, serial to avoid contention
    else:
        recommended_workers = min(non_exhausted, 8)

    print()
    print(f"Total consumed: ~{total_units} units across {len(keys)} keys")
    print(f"Non-exhausted keys: {non_exhausted}")
    print(f"Recommended max workers: {recommended_workers}")
    print(f"[source] Can proceed for ~{available // 5} more channel additions")


def cmd_cleanup_worker_notebooks(
    *, delete: bool, include_active: bool, only_current_state: bool = False
) -> int:
    """Reconcile industrial worker notebooks after an external child kill.

    This command is intentionally separate from ``fetch`` so a coordinator can
    invoke cleanup after it has terminated a timed-out child and its ``finally``
    block could not run.  The caller supplies the account-scoped worker
    environment; the cleanup helper's prefix and state-root guards remain the
    authority for what may be deleted.
    """
    if include_active and not delete:
        print("[source] --include-active requires --delete", file=sys.stderr)
        return 2
    if only_current_state and not include_active:
        print("[source] --only-current-state requires --include-active", file=sys.stderr)
        return 2
    deleted, failed = cleanup_stale_worker_notebooks(
        delete=delete,
        include_active=include_active,
        only_current_state=only_current_state,
    )
    print(
        f"[source] Worker notebook cleanup: deleted={deleted} failed={failed} "
        f"delete={delete} include_active={include_active} "
        f"only_current_state={only_current_state}"
    )
    return 1 if failed else 0


def cmd_block(url: str) -> None:
    """Add a channel to the blocklist."""
    # Normalize the URL
    channel_id = parse_channel_url(url)
    if channel_id:
        if channel_id.startswith("@"):
            canonical_url = f"https://www.youtube.com/{channel_id}"
        else:
            canonical_url = f"https://www.youtube.com/channel/{channel_id}"
    else:
        canonical_url = url

    block_channel(canonical_url)
    print(f"[source] Blocked: {canonical_url}")


def cmd_unblock(url: str) -> None:
    """Remove a channel from the blocklist."""
    channel_id = parse_channel_url(url)
    if channel_id:
        if channel_id.startswith("@"):
            canonical_url = f"https://www.youtube.com/{channel_id}"
        else:
            canonical_url = f"https://www.youtube.com/channel/{channel_id}"
    else:
        canonical_url = url

    was_blocked = unblock_channel(canonical_url)
    if was_blocked:
        print(f"[source] Unblocked: {canonical_url}")
    else:
        print(f"[source] Not on blocklist: {canonical_url}")


def cmd_list_blocked() -> None:
    """List all blocked channels."""
    blocked = get_all_blocked_channels()
    if not blocked:
        print("[source] No blocked channels.")
        return
    print("[source] Blocked channels:")
    for channel_url, blocked_at in blocked:
        print(f"  {channel_url}  (blocked {blocked_at[:19].replace('T', ' ')})")


def cmd_remove(url: str) -> None:
    """Remove a channel and all its video entries from the database."""
    channel_id = parse_channel_url(url)
    if channel_id:
        if channel_id.startswith("@"):
            canonical_url = f"https://www.youtube.com/{channel_id}"
        else:
            canonical_url = f"https://www.youtube.com/channel/{channel_id}"
    else:
        canonical_url = url

    deleted = delete_channel(canonical_url)
    if deleted:
        print(f"[source] Removed: {canonical_url}")
    else:
        print(f"[source] Not found in database: {canonical_url}")


def _parse_cookies_from_browser(spec: str) -> tuple[str, str | None, str | None]:
    """Parse a BROWSER[+KEYRING][:PROFILE] spec into yt-dlp's cookies tuple.

    Raises ValueError on an empty browser name.
    """
    parts = spec.split(":")
    browser_and_keyring = parts[0]
    profile = parts[1] if len(parts) > 1 and parts[1] else None
    if "+" in browser_and_keyring:
        browser, keyring = browser_and_keyring.split("+", 1)
    else:
        browser, keyring = browser_and_keyring, None
    browser = browser.strip()
    if not browser:
        raise ValueError("--cookies-from-browser needs a browser name, e.g. firefox:default-release")
    return browser, profile, keyring


def _cmd_playlist_import(
    playlist_kind: str,
    playlist_url: str,
    min_playlist_videos: int,
    dry_run: bool = False,
    cookies_from_browser: str | None = None,
) -> None:
    """Extract channels from a YouTube playlist and add new ones.

    Three filters applied:
    - subscriber_count > 100  (skip tiny/brand-new channels)
    - video_count > 2        (skip barely-active channels)
    - most recent video within 3 months (skip dormant/abandoned channels)

    Requires: YOUTUBE_API_KEY. Cookies come from --cookies-from-browser
    (live browser cookie store, always fresh) or ~/youtube_cookies.txt.
    """
    import os
    from datetime import datetime, timezone, timedelta
    from urllib.request import urlopen
    from xml.etree import ElementTree as ET

    playlist_label = "watch later" if playlist_kind == "watchlater" else "history"

    print(f"[source] Step 1: Fetching {playlist_label} video IDs (yt-dlp Python API, no API quota)...")

    # Cookies: an explicit --cookies-from-browser spec reads the live browser
    # cookie store (always fresh); otherwise fall back to the exported file.
    cookiesfrombrowser = None
    cookie_file = os.path.expanduser("~/youtube_cookies.txt")
    if cookies_from_browser:
        cookiesfrombrowser = _parse_cookies_from_browser(cookies_from_browser)
        cookie_file = None
    elif not os.path.exists(cookie_file):
        # Fall back to no cookies (anonymous; WL/history need auth to work)
        cookie_file = None

    try:
        import yt_dlp
        ydl_opts = {
            "quiet": True,
            "cookiefile": cookie_file,
            "cookiesfrombrowser": cookiesfrombrowser,
            "extract_flat": "in_playlist",
            "skip_download": True,
            "socket_timeout": 60,
        }
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            result = ydl.extract_info(playlist_url, download=False)
            entries = result.get("entries", []) or []
    except Exception as e:
        print(f"[source] Error fetching {playlist_label}: {e}", file=sys.stderr)
        sys.exit(1)

    playlist_entries = [e for e in entries if e and e.get("id")]
    video_ids = [str(e["id"]) for e in playlist_entries]
    print(f"[source] Found {len(video_ids)} video IDs in {playlist_label}")

    if not video_ids:
        print(f"[source] No videos found in {playlist_label}.", file=sys.stderr)
        sys.exit(1)

    run_id = record_playlist_import_run(
        playlist_kind=playlist_kind,
        playlist_url=playlist_url,
        command=f"csf-source {playlist_kind}",
        cookie_source=cookie_file or "browser",
        total_items=len(video_ids),
        notes={
            "playlist_label": playlist_label,
            "dry_run": dry_run,
            "min_playlist_videos": min_playlist_videos,
        },
    )
    for idx, entry in enumerate(playlist_entries, start=1):
        video_id = str(entry.get("id") or "")
        record_playlist_import_item(
            run_id=run_id,
            item_id=f"{playlist_kind}:{idx}:{video_id}",
            playlist_kind=playlist_kind,
            playlist_url=playlist_url,
            playlist_position=idx,
            video_id=video_id or None,
            video_url=f"https://www.youtube.com/watch?v={video_id}" if video_id else None,
            video_title=entry.get("title"),
            channel_id=None,
            channel_url=None,
            channel_title=None,
            published_at=entry.get("timestamp") or entry.get("upload_date"),
            duration_seconds=entry.get("duration"),
            availability=entry.get("availability"),
            is_live=entry.get("is_live"),
            raw_json=entry,
            resolved_channel_json={},
            classification="fetched",
        )

    print(f"[source] Step 2: Resolving {len(video_ids)} video IDs → channel IDs (API, ~{len(video_ids)} units)...")

    from csf.source_enumerator import _api_request

    channel_video_map: dict[str, list[str]] = {}
    video_to_channel: dict[str, str] = {}
    for i in range(0, len(video_ids), 50):
        batch = video_ids[i : i + 50]
        params = {"part": "snippet", "id": ",".join(batch)}
        resp = _api_request("videos", params, unit_cost=1)
        if resp is None:
            continue

        for item in resp.get("items", []):
            vid = item.get("id")
            snippet = item.get("snippet", {})
            ch_id = snippet.get("channelId", "")
            if vid and ch_id:
                channel_video_map.setdefault(ch_id, []).append(vid)
                video_to_channel[vid] = ch_id

        if (i + 50) % 500 == 0 or i + 50 >= len(video_ids):
            print(f"  ... resolved {min(i + 50, len(video_ids))}/{len(video_ids)}")

    channel_history_counts = {cid: len(vids) for cid, vids in channel_video_map.items()}
    qualified = {cid: vids for cid, vids in channel_video_map.items() if len(vids) >= min_playlist_videos}
    print(f"[source] Channels with ≥{min_playlist_videos} {playlist_label} videos: {len(qualified)}/{len(channel_video_map)}")

    if not qualified:
        print(f"[source] No channels passed the {playlist_label}-video threshold.")
        sys.exit(1)

    # Get already-tracked UC IDs
    existing_uc_ids: set[str] = set()
    storage = _get_batch_status_storage()
    storage._ensure_channel_metadata()
    conn = storage._get_conn()
    for row in conn.execute("SELECT channel_url FROM channel_metadata").fetchall():
        cu = row[0]
        m = re.search(r"/channel/(UC[a-zA-Z0-9_-]+)", cu)
        if m:
            existing_uc_ids.add(m.group(1))
        elif cu.startswith("UC"):
            existing_uc_ids.add(cu)
    # Tombstone guard: blacklisted/blocked channels (deleted from the DB by
    # blacklist_channels, or excluded) must never be re-imported.
    blacklisted_uc_ids: set[str] = set()
    try:
        for row in conn.execute("SELECT channel_url, channel_id FROM channel_blocklist").fetchall():
            cu, cid = row[0], row[1]
            m = re.search(r"/channel/(UC[a-zA-Z0-9_-]+)", cu or "")
            if m:
                blacklisted_uc_ids.add(m.group(1))
            elif cu and cu.startswith("UC"):
                blacklisted_uc_ids.add(cu)
            if cid and cid.startswith("UC"):
                blacklisted_uc_ids.add(cid)
    except Exception:
        pass
    conn.close()
    tombstone_blocked = [cid for cid in qualified if cid in blacklisted_uc_ids]
    if tombstone_blocked:
        print(f"[source] Skipping {len(tombstone_blocked)} blacklisted/blocked channel(s) "
              "(excluded or deleted via blacklist — never re-imported).")

    new_qualified = [cid for cid in qualified if cid not in existing_uc_ids and cid not in blacklisted_uc_ids]
    print(f"[source] Already tracked: {len(qualified) - len(new_qualified)}")
    print(f"[source] New to add (before filters): {len(new_qualified)}")

    if dry_run:
        finish_playlist_import_run(
            run_id,
            status="dry_run",
            total_items=len(video_ids),
            resolved_items=len(video_to_channel),
            new_channels=len(new_qualified),
            already_tracked_channels=len(qualified) - len(new_qualified),
            blocked_channels=0,
            failed_items=len(video_ids) - len(video_to_channel),
        )
        print(f"\n[source] DRY RUN — would add {len(new_qualified)} channels (filters not yet applied):")
        for cid in sorted(new_qualified)[:50]:
            print(f"  [{channel_history_counts[cid]} videos] https://www.youtube.com/channel/{cid}")
        if len(new_qualified) > 50:
            print(f"  ... and {len(new_qualified) - 50} more")
        print(f"\n[source] Filters (applied on real run):")
        print(f"  subscriber_count > 100")
        print(f"  video_count > 2")
        print(f"  most recent video within 3 months")
        print(f"\n[source] Run without --dry-run to apply filters and add.")
        return

    if not new_qualified:
        finish_playlist_import_run(
            run_id,
            status="completed",
            total_items=len(video_ids),
            resolved_items=len(video_to_channel),
            new_channels=0,
            already_tracked_channels=len(qualified),
            blocked_channels=0,
            failed_items=len(video_ids) - len(video_to_channel),
        )
        print("[source] All qualified history channels already tracked.")
        return

    # Step 3: Apply filters and add
    print(f"[source] Step 3: Applying filters to {len(new_qualified)} channels...")
    print(f"[source] Filters: subscriber_count>100, video_count>2, newest_video≤3mo")

    # Batch-fetch channel metadata: 50 channels per channels.list call (5 units each)
    # vs per-channel get_upload_playlist_id which makes 2 calls each (1+5 units)
    # For 699 channels: ~14 batch calls (70 units) vs ~1398 individual calls (4194 units)
    print(f"[source] Fetching channel metadata in batch (~{len(new_qualified)//50 + 1} API calls, ~5 units/call)...")
    channel_meta: dict[str, dict] = {}
    for i in range(0, len(new_qualified), 50):
        batch = new_qualified[i:i + 50]
        params = {"id": ",".join(batch), "part": "contentDetails,statistics,snippet"}
        resp = _api_request("channels", params, unit_cost=5)
        if not resp or "items" not in resp:
            for uc_id in batch:
                channel_meta[uc_id] = None
            continue

        for item in resp["items"]:
            cid = item.get("id", "")
            if not cid:
                continue
            snippet = item.get("snippet", {})
            content_details = item.get("contentDetails", {})
            statistics = item.get("statistics", {})
            uploads_playlist = content_details.get("relatedPlaylists", {}).get("uploads", "")

            channel_meta[cid] = {
                "title": snippet.get("title", ""),
                "subs": int(statistics.get("subscriberCount", 0) or 0),
                "videos": int(statistics.get("videoCount", 0) or 0),
                "playlist_id": uploads_playlist,
            }
        fetched = min(i + 50, len(new_qualified))
        if (i + 50) % 500 == 0 or fetched >= len(new_qualified):
            print(f"  ... fetched {fetched}/{len(new_qualified)}")

    # Check recency via RSS (free, no quota) for each channel
    cutoff = datetime.now(timezone.utc) - timedelta(days=90)
    three_months_ago = cutoff.strftime("%Y-%m-%d")

    print(f"[source] Checking recency via RSS feed (free, no quota)...")

    def get_latest_video_date(uc_id: str) -> str | None:
        """Fetch most recent video date via RSS. Returns ISO date or None."""
        ATOM_NS = "http://www.w3.org/2005/Atom"
        try:
            rss_url = f"https://www.youtube.com/feeds/videos.xml?channel_id={uc_id}"
            with urlopen(rss_url, timeout=10) as resp:
                tree = ET.parse(resp)
                root = tree.getroot()
                entries = root.findall(f"{{{ATOM_NS}}}entry")
                if not entries:
                    return None
                pub = entries[0].find(f"{{{ATOM_NS}}}published")
                if pub is None:
                    pub = entries[0].find("published")
                return pub.text if pub is not None else None
        except Exception:
            return None

    passed_filters = []
    skipped_filters: dict[str, list[str]] = {
        "subs≤100": [],
        "videos≤2": [],
        "stale>3mo": [],
        "no_meta": [],
    }

    # Pre-fetch RSS recency for all channels in parallel (20 workers)
    # Each RSS call is ~1-3s; 726 channels sequentially = ~30 min; in parallel ~= ~2 min
    print(f"[source] Checking recency via RSS feed ({len(new_qualified)} channels, 20 workers)...")
    from concurrent.futures import ThreadPoolExecutor, as_completed
    rss_dates: dict[str, str | None] = {}
    with ThreadPoolExecutor(max_workers=20) as executor:
        futures = {executor.submit(get_latest_video_date, cid): cid for cid in new_qualified}
        done = 0
        for future in as_completed(futures):
            cid = futures[future]
            rss_dates[cid] = future.result()
            done += 1
            if done % 100 == 0 or done == len(new_qualified):
                print(f"  ... RSS checked {done}/{len(new_qualified)}")

    print(f"[source] Applying filters to {len(new_qualified)} channels...")

    for uc_id in new_qualified:
        meta = channel_meta.get(uc_id)
        if meta is None:
            skipped_filters["no_meta"].append(uc_id)
            continue

        # Filter: subscriber count > 100
        subs = meta["subs"] if meta else 0
        if subs <= 100:
            skipped_filters["subs≤100"].append(uc_id)
            continue

        # Filter: video count > 2
        vid_count = meta["videos"] if meta else 0
        if vid_count <= 2:
            skipped_filters["videos≤2"].append(uc_id)
            continue

        # Filter: most recent video within 3 months
        latest = rss_dates.get(uc_id)
        if latest is None:
            skipped_filters["no_meta"].append(uc_id)
            continue
        try:
            latest_dt = datetime.fromisoformat(latest.replace("Z", "+00:00"))
            if latest_dt < cutoff:
                skipped_filters["stale>3mo"].append(uc_id)
                continue
        except ValueError:
            pass

        passed_filters.append(uc_id)

    print(f"[source] Filters applied:")
    print(f"  passed: {len(passed_filters)}")
    for reason, cids in skipped_filters.items():
        print(f"  skipped ({reason}): {len(cids)}")

    if not passed_filters:
        print("[source] No channels passed all filters.")
        sys.exit(0)

    print(f"[source] Step 4: Adding {len(passed_filters)} channels (no full enumeration — sync will handle lazily)...")

    added = 0
    failed = 0
    blocked = 0

    for uc_id in passed_filters:
        channel_url = f"https://www.youtube.com/channel/{uc_id}"
        if is_channel_blocked(channel_url):
            print(f"  [skip blocked] {channel_url}")
            blocked += 1
            for video_id in channel_video_map.get(uc_id, []):
                record_playlist_import_item(
                    run_id=run_id,
                    item_id=f"{playlist_kind}:{video_id}:blocked",
                    playlist_kind=playlist_kind,
                    playlist_url=playlist_url,
                    playlist_position=None,
                    video_id=video_id,
                    video_url=f"https://www.youtube.com/watch?v={video_id}",
                    video_title=None,
                    channel_id=uc_id,
                    channel_url=channel_url,
                    channel_title=None,
                    published_at=None,
                    duration_seconds=None,
                    availability="blocked",
                    is_live=None,
                    raw_json={},
                    resolved_channel_json={"status": "blocked"},
                    classification="blocked",
                )
            continue

        meta = channel_meta.get(uc_id)
        if not meta:
            failed += 1
            for video_id in channel_video_map.get(uc_id, []):
                record_playlist_import_item(
                    run_id=run_id,
                    item_id=f"{playlist_kind}:{video_id}:failed",
                    playlist_kind=playlist_kind,
                    playlist_url=playlist_url,
                    playlist_position=None,
                    video_id=video_id,
                    video_url=f"https://www.youtube.com/watch?v={video_id}",
                    video_title=None,
                    channel_id=uc_id,
                    channel_url=channel_url,
                    channel_title=None,
                    published_at=None,
                    duration_seconds=None,
                    availability="missing_meta",
                    is_live=None,
                    raw_json={},
                    resolved_channel_json={"status": "missing_meta"},
                    classification="failed",
                )
            continue

        uploads_playlist_id = meta["playlist_id"]
        if not uploads_playlist_id or len(uploads_playlist_id) != 24:
            failed += 1
            for video_id in channel_video_map.get(uc_id, []):
                record_playlist_import_item(
                    run_id=run_id,
                    item_id=f"{playlist_kind}:{video_id}:failed",
                    playlist_kind=playlist_kind,
                    playlist_url=playlist_url,
                    playlist_position=None,
                    video_id=video_id,
                    video_url=f"https://www.youtube.com/watch?v={video_id}",
                    video_title=None,
                    channel_id=uc_id,
                    channel_url=channel_url,
                    channel_title=meta["title"] or None,
                    published_at=None,
                    duration_seconds=None,
                    availability="missing_uploads",
                    is_live=None,
                    raw_json={},
                    resolved_channel_json={"status": "missing_uploads"},
                    classification="failed",
                )
            continue

        # Skip full enumerate_full() — let sync handle it lazily
        # last_full_enumeration=None forces sync to enumerate on next run
        now = datetime.now(timezone.utc).isoformat()
        set_channel_metadata(
            channel_url,
            playlist_id=uploads_playlist_id,
            last_checked=now,
            last_full_enumeration=None,  # sync will enumerate lazily
            video_count_estimate=meta["videos"],
            channel_title=meta["title"] or None,
            thumbnail_url=None,
            subscriber_count=meta["subs"] or None,
            view_count=None,
        )
        hist_count = channel_history_counts.get(uc_id, 0)
        print(f"  OK: {meta['title'] or uc_id} ({meta['videos']} videos total, {hist_count} from history)")
        added += 1
        for video_id in channel_video_map.get(uc_id, []):
            record_playlist_import_item(
                run_id=run_id,
                item_id=f"{playlist_kind}:{video_id}:accepted",
                playlist_kind=playlist_kind,
                playlist_url=playlist_url,
                playlist_position=None,
                video_id=video_id,
                video_url=f"https://www.youtube.com/watch?v={video_id}",
                video_title=None,
                channel_id=uc_id,
                channel_url=channel_url,
                channel_title=meta["title"] or None,
                published_at=None,
                duration_seconds=None,
                availability="accepted",
                is_live=None,
                raw_json={},
                resolved_channel_json={
                    "channel_id": uc_id,
                    "channel_url": channel_url,
                    "channel_title": meta["title"] or None,
                    "status": "accepted",
                },
                classification="accepted",
            )

    print()
    print(f"[source] Done: {added} added, {failed} failed out of {len(passed_filters)}")
    print(f"[source] Full video enumeration will happen on next sync — {added} channels will be processed then.")
    for reason, cids in skipped_filters.items():
        if cids:
            print(f"[source] Skipped ({reason}): {len(cids)}")
    finish_playlist_import_run(
        run_id,
        status="completed",
        total_items=len(video_ids),
        resolved_items=len(video_to_channel),
        new_channels=added,
        already_tracked_channels=len(qualified) - len(new_qualified),
        blocked_channels=blocked,
        failed_items=failed + (len(video_ids) - len(video_to_channel)),
    )


def cmd_history(
    min_history_videos: int = 2, dry_run: bool = False, cookies_from_browser: str | None = None
) -> None:
    """Import channels from watch history."""
    _cmd_playlist_import(
        playlist_kind="history",
        playlist_url="https://www.youtube.com/feed/history",
        min_playlist_videos=min_history_videos,
        dry_run=dry_run,
        cookies_from_browser=cookies_from_browser,
    )


def cmd_watchlater(
    min_watchlater_videos: int = 2, dry_run: bool = False, cookies_from_browser: str | None = None
) -> None:
    """Import channels from Watch Later."""
    _cmd_playlist_import(
        playlist_kind="watchlater",
        playlist_url="https://www.youtube.com/playlist?list=WL",
        min_playlist_videos=min_watchlater_videos,
        dry_run=dry_run,
        cookies_from_browser=cookies_from_browser,
    )


def main() -> None:
    # Workspace .env (YT_API_KEY_* aliases etc.) fills only unset vars, so an
    # explicit shell environment always wins.
    loaded_env = load_workspace_env()
    if loaded_env:
        print(f"[source] loaded {len(loaded_env)} env vars from workspace .env", file=sys.stderr)
    parser = argparse.ArgumentParser(
        description="YouTube source management CLI — Phase 2."
    )
    parser.add_argument(
        "--allow-spend",
        action="store_true",
        default=False,
        help="Authorize YouTube API spending for this run only. Dies with the process."
    )
    parser.add_argument(
        "--spend-budget",
        type=int,
        default=None,
        metavar="UNITS",
        help="Cap this run's total YouTube API unit spend (requires --allow-spend)."
    )
    subparsers = parser.add_subparsers(dest="command", help="Command to run")

    # add command
    add_parser = subparsers.add_parser("add", help="Add a new channel or playlist source")
    add_parser.add_argument("url", help="Channel URL or playlist URL")

    # list command
    subparsers.add_parser("list", help="List all tracked sources")

    # check command
    check_parser = subparsers.add_parser("check", help="Daily check for a source")
    check_parser.add_argument("source", help="Source ID (channel URL or bare channel ID)")

    # check-all command
    check_all_parser = subparsers.add_parser("check-all", help="Check all tracked channels for new videos")
    check_all_parser.add_argument("--verbose", "-v", action="store_true", help="Show detailed output")

    # categorize command
    categorize_parser = subparsers.add_parser("categorize", help="LLM-categorize all channels (idempotent, skips categorized)")
    categorize_parser.add_argument("--workers", type=int, default=1, help="Number of parallel workers (default: 1)")
    categorize_parser.add_argument(
        "--retry-other",
        action="store_true",
        help="Re-attempt channels stored as 'Other' (never manual decisions) — use after backfilling metadata.",
    )
    categorize_parser.add_argument(
        "--refresh-video-titles",
        action="store_true",
        help="Ignore cached video titles and refetch RSS (cache repopulates).",
    )
    categorize_parser.add_argument(
        "--all",
        action="store_true",
        help="Re-classify EVERY channel, overriding manual/sticky classifications "
        "— the full-evidence mistake fix. Implies --video-titles.",
    )
    categorize_parser.add_argument(
        "--category",
        default=None,
        help="Reclassify every channel currently in this category (full evidence, "
        "overrides stickiness) — e.g. re-do all of News.",
    )
    categorize_parser.add_argument(
        "--channels",
        default=None,
        help="Comma-separated URLs/IDs (or @file with a list) to reclassify now, "
        "overriding current categories; always uses video titles too.",
    )
    categorize_parser.add_argument(
        "--video-titles",
        action="store_true",
        help="Include recent video titles (RSS, free) in the classification prompt — the strongest signal for thin metadata.",
    )

    # sync command
    sync_parser = subparsers.add_parser("sync", help="Process pending videos for a source")
    sync_parser.add_argument("source", help="Source ID (channel URL or bare channel ID)")

    # quota command
    subparsers.add_parser("quota", help="Show per-key quota state and recommended workers")

    # fetch command (escalation batch process)
    fetch_parser = subparsers.add_parser(
        "fetch",
        help="Fetch transcripts using the full fallback chain (oEmbed → yt-dlp → yt-dlp+cookies → direct API → NotebookLM → Selenium → Whisper)",
    )
    fetch_parser.add_argument("--source", help="Process only this channel URL")
    fetch_parser.add_argument("--dry-run", action="store_true", help="Show what would be fetched without fetching")
    fetch_parser.add_argument("--workers", type=int, default=1, help="Number of parallel workers (default: 1)")
    fetch_parser.add_argument(
        "--adaptive-workers",
        action="store_true",
        help="Opt in to bounded adaptive industrial worker scaling; fixed worker mode remains the default",
    )
    fetch_parser.add_argument(
        "--adaptive-max-workers",
        type=int,
        help="Required maximum industrial workers when --adaptive-workers is enabled",
    )
    fetch_parser.add_argument("--adaptive-min-workers", type=int)
    fetch_parser.add_argument("--adaptive-scale-up-backlog", type=int)
    fetch_parser.add_argument("--adaptive-scale-down-backlog", type=int)
    fetch_parser.add_argument("--adaptive-cooldown-s", type=float)
    fetch_parser.add_argument("--adaptive-health-window", type=int)
    fetch_parser.add_argument("--limit", type=int, help="Stop after this many pending items have been queued for fetching")
    fetch_parser.add_argument(
        "--video-manifest",
        type=Path,
        help="Select exact video IDs from a validated JSON manifest (mutually exclusive with --source)",
    )
    fetch_parser.add_argument(
        "--selection-receipt",
        type=Path,
        help="Write an atomic JSON receipt for a video-manifest selection",
    )
    fetch_parser.add_argument(
        "--overwrite-selection-receipt",
        action="store_true",
        help="Allow replacing an existing selection receipt",
    )
    fetch_parser.add_argument(
        "--verify-selection-receipt",
        type=Path,
        help="Fail closed unless the current manifest/database selection matches this receipt",
    )
    fetch_parser.add_argument(
        "--fallback-only",
        action="store_true",
        help="Process only an exact video manifest through transcript fallback; never invoke NotebookLM",
    )
    fetch_parser.add_argument(
        "--route-source-add-failures-to-fallback",
        action="store_true",
        help="Route only persisted Source add failed industrial rows to transcript fallback",
    )
    fetch_parser.add_argument(
        "--route-source-addressability-failures-to-fallback",
        action="store_true",
        help="Route only SourceNotFoundError content failures to transcript fallback",
    )

    # block command
    block_parser = subparsers.add_parser("block", help="Add a channel to the blocklist")
    block_parser.add_argument("url", help="Channel URL or @handle")

    # unblock command
    unblock_parser = subparsers.add_parser("unblock", help="Remove a channel from the blocklist")
    unblock_parser.add_argument("url", help="Channel URL or @handle")

    # remove command
    remove_parser = subparsers.add_parser("remove", help="Remove a channel and all its videos from the database")
    remove_parser.add_argument("url", help="Channel URL or @handle")

    # list-blocked command
    subparsers.add_parser("list-blocked", help="List all blocked channels")

    # cleanup command used by the coordinator after a child timeout
    cleanup_parser = subparsers.add_parser(
        "cleanup-worker-notebooks",
        help="Audit or delete account-scoped industrial worker notebooks",
    )
    cleanup_parser.add_argument("--delete", action="store_true")
    cleanup_parser.add_argument(
        "--include-active",
        action="store_true",
        help="delete active worker-prefix notebooks and clear worker state files",
    )
    cleanup_parser.add_argument(
        "--only-current-state",
        action="store_true",
        help="when deleting active workers, target only IDs in the current state root",
    )

    # history command
    history_parser = subparsers.add_parser(
        "history",
        help="Extract channels from YouTube watch history and add new ones",
    )
    history_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Preview channels without adding them",
    )
    history_parser.add_argument(
        "--min-history-videos",
        type=int,
        default=2,
        help="Minimum videos watched from a channel to qualify (default: 2)",
    )
    history_parser.add_argument(
        "--cookies-from-browser",
        default=None,
        help="Read YouTube cookies from a live browser profile, e.g. firefox:default-release (fresh; no manual export)",
    )

    # watchlater command
    watchlater_parser = subparsers.add_parser(
        "watchlater",
        help="Extract channels from YouTube Watch Later and add new ones",
    )
    watchlater_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Preview channels without adding them",
    )
    watchlater_parser.add_argument(
        "--min-watchlater-videos",
        type=int,
        default=2,
        help="Minimum videos in Watch Later from a channel to qualify (default: 2)",
    )
    watchlater_parser.add_argument(
        "--cookies-from-browser",
        default=None,
        help="Read YouTube cookies from a live browser profile, e.g. firefox:default-release (fresh; no manual export)",
    )

    args = parser.parse_args()

    # Per-process spend authorization — --allow-spend flag
    if getattr(args, "allow_spend", False):
        from csf.source_enumerator import set_spend_authorized

        set_spend_authorized(True)
        if getattr(args, "spend_budget", None) is not None:
            from csf.source_enumerator import set_spend_budget

            set_spend_budget(args.spend_budget)
            print(f"[source] Spend budget: {args.spend_budget} API units for this run.")

    if args.command == "add":
        cmd_add(args.url)
    elif args.command == "list":
        cmd_list()
    elif args.command == "check":
        cmd_check(args.source)
    elif args.command == "check-all":
        cmd_check_all(verbose=args.verbose)
    elif args.command == "categorize":
        cmd_categorize(
            workers=args.workers,
            retry_other=args.retry_other,
            video_titles=args.video_titles,
            channels=args.channels,
            category=args.category,
            all_channels=getattr(args, "all", False),
            refresh_video_titles=getattr(args, "refresh_video_titles", False),
        )
    elif args.command == "sync":
        cmd_sync(args.source)
    elif args.command == "quota":
        cmd_quota()
    elif args.command == "fetch":
        if args.video_manifest is not None and args.source is not None:
            parser.error("--video-manifest and --source are mutually exclusive")
        if args.video_manifest is not None and not args.dry_run and args.limit is None:
            parser.error("live --video-manifest fetch requires --limit")
        if args.selection_receipt is not None and args.video_manifest is None:
            parser.error("--selection-receipt requires --video-manifest")
        if args.verify_selection_receipt is not None and args.video_manifest is None:
            parser.error("--verify-selection-receipt requires --video-manifest")
        if args.fallback_only and args.video_manifest is None:
            parser.error("--fallback-only requires --video-manifest")
        # Scope guardrail: refuse unbounded fetch when backlog is large.
        # Prevents the scope-blowout incident (2026-07-20) where an unbounded
        # `fetch` attempted all 51k pending videos instead of the intended
        # ~5.7k recent-scope subset. See README.md "Scope rule (mandatory)".
        if args.limit is None and not args.dry_run:
            try:
                import sqlite3 as _sql
                from csf.batch_status import _get_default_db_path as _get_bs_path
                _bs_path = _get_bs_path()
                _conn = _sql.connect(_bs_path)
                _pending = _conn.execute(
                    "SELECT COUNT(*) FROM analysis_status WHERE status = 'pending'"
                ).fetchone()[0]
                _conn.close()
                if _pending > 1000:
                    print(
                        f"[scope-guard] REFUSING unbounded fetch: {_pending} pending videos in backlog.\n"
                        f"  This guard prevents accidental scope blowout. Either:\n"
                        f"    (a) pass --limit <N> with the intended scope, or\n"
                        f"    (b) recompute the recent-window scope with:\n"
                        f"        SELECT COUNT(*) FROM analysis_status\n"
                        f"        WHERE status='pending' AND has_captions IS NULL\n"
                        f"          AND updated_at >= strftime('%Y-%m-%dT%H:%M:%SZ','now','-6 days');\n"
                        f"  See README.md \"Production fetch operations\" for the validated config and scope rule.",
                        file=sys.stderr,
                    )
                    sys.exit(2)
            except Exception as _e:
                # Fail open: if the guardrail can't query the DB, let cmd_fetch run.
                # Don't block production on a guardrail infra failure.
                print(f"[scope-guard] pre-check skipped: {_e}", file=sys.stderr)

        cmd_fetch(
            source_filter=args.source,
            dry_run=args.dry_run,
            workers=args.workers,
            max_items=args.limit,
            video_manifest=args.video_manifest,
            selection_receipt=args.selection_receipt,
            overwrite_selection_receipt=args.overwrite_selection_receipt,
            verify_selection_receipt_path=args.verify_selection_receipt,
            adaptive_workers=args.adaptive_workers or os.getenv("YTIS_INDUSTRIAL_ADAPTIVE_WORKERS", "").lower() in {"1", "true", "yes", "on"},
            adaptive_min_workers=args.adaptive_min_workers if args.adaptive_min_workers is not None else int(os.getenv("YTIS_INDUSTRIAL_ADAPTIVE_MIN_WORKERS", "1")),
            adaptive_max_workers=(
                args.adaptive_max_workers
                if args.adaptive_max_workers is not None
                else int(os.environ["YTIS_INDUSTRIAL_ADAPTIVE_MAX_WORKERS"])
                if os.getenv("YTIS_INDUSTRIAL_ADAPTIVE_MAX_WORKERS")
                else None
            ),
            adaptive_scale_up_backlog=args.adaptive_scale_up_backlog if args.adaptive_scale_up_backlog is not None else int(os.getenv("YTIS_INDUSTRIAL_ADAPTIVE_SCALE_UP_BACKLOG", "2")),
            adaptive_scale_down_backlog=args.adaptive_scale_down_backlog if args.adaptive_scale_down_backlog is not None else int(os.getenv("YTIS_INDUSTRIAL_ADAPTIVE_SCALE_DOWN_BACKLOG", "0")),
            adaptive_cooldown_s=args.adaptive_cooldown_s if args.adaptive_cooldown_s is not None else float(os.getenv("YTIS_INDUSTRIAL_ADAPTIVE_COOLDOWN_S", "60")),
            adaptive_health_window=args.adaptive_health_window if args.adaptive_health_window is not None else int(os.getenv("YTIS_INDUSTRIAL_ADAPTIVE_HEALTH_WINDOW", "2")),
            fallback_only=args.fallback_only,
            route_source_add_failures_to_fallback=(
                args.route_source_add_failures_to_fallback
                or os.getenv("YTIS_ROUTE_SOURCE_ADD_FAILURES_TO_FALLBACK", "").lower()
                in {"1", "true", "yes", "on"}
            ),
            route_source_addressability_failures_to_fallback=(
                args.route_source_addressability_failures_to_fallback
                or os.getenv("YTIS_ROUTE_SOURCE_ADDRESSABILITY_FAILURES_TO_FALLBACK", "").lower()
                in {"1", "true", "yes", "on"}
            ),
        )
    elif args.command == "block":
        cmd_block(args.url)
    elif args.command == "unblock":
        cmd_unblock(args.url)
    elif args.command == "remove":
        cmd_remove(args.url)
    elif args.command == "list-blocked":
        cmd_list_blocked()
    elif args.command == "cleanup-worker-notebooks":
        status = cmd_cleanup_worker_notebooks(
            delete=args.delete,
            include_active=args.include_active,
            only_current_state=args.only_current_state,
        )
        if status:
            sys.exit(status)
    elif args.command == "history":
        cmd_history(
            min_history_videos=args.min_history_videos,
            dry_run=args.dry_run,
            cookies_from_browser=args.cookies_from_browser,
        )
    elif args.command == "watchlater":
        cmd_watchlater(
            min_watchlater_videos=args.min_watchlater_videos,
            dry_run=args.dry_run,
            cookies_from_browser=args.cookies_from_browser,
        )
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
