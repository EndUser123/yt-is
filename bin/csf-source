def _build_result_quality_metrics(result: TranscriptResult) -> str:
    """Serialize deterministic transcript evidence for every completion path."""
    metrics = build_transcript_quality_metrics(result.transcript)
    for field_name in ("source", "last_stage", "raw_lang"):
        value = getattr(result, field_name, None)
        if value is None or isinstance(value, (str, int, float, bool)):
            metrics[field_name] = value
    for field_name in (
        "view_count",
        "like_count",
        "comment_count",
        "duration",
    ):
        value = getattr(result, field_name, None)
        if value is None or isinstance(value, (str, int, float, bool)):
            metrics[field_name] = value
    for field_name in ("video_title", "video_description"):
        value = getattr(result, field_name, None)
        if value is None or isinstance(value, str):
            metrics["title" if field_name == "video_title" else "description"] = (
                value[:500] if isinstance(value, str) else value
            )
    view_count = metrics.get("view_count")
    like_count = metrics.get("like_count")
    comment_count = metrics.get("comment_count")
    if isinstance(view_count, (int, float)) and view_count:
        if isinstance(like_count, (int, float)):
            metrics["like_rate"] = round(like_count / view_count, 6)
        else:
            metrics["like_rate"] = None
        if isinstance(comment_count, (int, float)):
            metrics["comment_rate"] = round(comment_count / view_count, 6)
        else:
            metrics["comment_rate"] = None
    return json.dumps(metrics, ensure_ascii=True, sort_keys=True)


