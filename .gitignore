# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Test / Coverage
.pytest_cache/
.coverage
.pytest_cache/
htmlcov/
.tox/
.benchmarks/

# Type checking
.mypy_cache/
.ruff_cache/

# Data stores (local only - never push to GitHub)
*.sqlite
*.sqlite3
history.json
youtube_cookies.txt

# Logs
*.log
logs/
.logs/batch_size_series/
.logs/batch_size_series_v3/
.claude-state/

# Curated auth benchmark evidence is added explicitly when needed.
# Ignore new sharded lane trees by default so bulk run roots do not get staged.
.logs/sharded_lane_series/**
!.logs/sharded_lane_series/**/
!.logs/sharded_lane_series/**/sharded_lane_series_summary.json
!.logs/sharded_lane_series/**/logs/
!.logs/sharded_lane_series/**/logs/term_*.jsonl

# Temp scratch files
tmp-*.txt
tmp-*.md

# Evidence / Research
.evidence/
.research_report.md

# OS
.DS_Store
Thumbs.db

# Local config overrides
config/local.yaml
config/local.yml

# Evidence (global location: ~/.claude/.evidence/)
.claude/state/
.browser/
*.jsonl

# Worktree pointer files: prevent worktree gitdir pointers from being tracked
.claude/worktrees/*
!.claude/worktrees/.gitkeep

# NotebookLM auth storage - NEVER commit (contains live Google session cookies)
# Backup lives in C:\Users\brsth\.ytis-nlm-auth-backup\ (bare repo, no remote, pre-push blocked)
.data/yt-is/nlm-auth/

# Browser profile data (runtime state, contains credentials - never track)
.browser/

# Local-only DB artifacts (extension mismatch vs the *.sqlite rule)
*.db

# Machine-local discovery cycle settings (browser profile etc.)
config/discovery-settings.json

# Multi-account fetch receipts (contain auth material - never commit)
.logs/multi_account_fetch/

# Runtime lock files (empty artifacts of the lock machinery)
.data/yt-is/locks/
docs/evidence-fabric/benchmark/corpus.json
.logs/chrome_free2_launch.log

# DHT capture browser profile (holds live Discord session — never track)
scripts/dht-capture/profile*/
# DHT tracking script (contains app local-server token — never track)
scripts/dht-capture/tracking-script.js
# DHT fresh tracking script (per-session token — never track)
scripts/dht-capture/tracking-script-fresh.js
